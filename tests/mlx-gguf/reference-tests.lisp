(in-package #:cl-inference/mlx-gguf/tests)
(in-suite :cl-inference/mlx-gguf)

(defun reference-object (&rest pairs)
  (let ((object (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key object) value))
    object))

(test strict-reference-missing-hashes-and-provenance
  (f::with-hf-directory (root)
    (let* ((case :llama-q4_0-plain)
           (directory (merge-pathnames "reference/oracle/llama-q4_0-plain/" root))
           (model (merge-pathnames "reference/models/fixture.gguf" root))
           (source (merge-pathnames "tests/acceptance/oracle/dump-trace.cpp" root))
           (manifest-path (merge-pathnames "tools/mlx-gguf-reference-manifest.json" root))
           (*hashes* (make-hash-table :test 'equal))
           (cl-inference/acceptance::*quant-manifest* (reference-object))
           (files (reference-object)))
      (dolist (path (list model source manifest-path (merge-pathnames "trace.txt" directory)))
        (ensure-directories-exist path))
      (f::write-octets model #(1 2 3))
      (f::write-octets source #(4 5 6))
      (let* ((pin (reference-object "file" "fixture.gguf" "sha256" (reference-sha model)
                                  "source_sha256" "source" "llama_cpp" "pinned" "dtype" "q4_0"))
             (provenance (reference-object "sha256" (gethash "sha256" pin) "source_sha256" "source"
                                         "llama_cpp" "pinned" "dtype" "q4_0" "native" nil))
             (entry (reference-object "model" pin "oracle_source_sha256" (reference-sha source) "files" files))
             (manifest (reference-object "llama-q4_0-plain" entry)))
        (setf (gethash "llama-q4_0" cl-inference/acceptance::*quant-manifest*) pin)
        (dolist (name '("prompt.ids" "greedy.ids" "trace.txt" "top.txt" "decode.f32"))
          (f::write-octets (merge-pathnames name directory) #(0 0 0 0)))
        (f::write-hf-json directory "provenance.json" provenance)
        (flet ((save ()
                 (clrhash *hashes*)
                 (dolist (name '("prompt.ids" "greedy.ids" "trace.txt" "top.txt" "decode.f32" "provenance.json"))
                   (setf (gethash name files) (reference-sha (merge-pathnames name directory))))
                 (f::write-hf-json root "tools/mlx-gguf-reference-manifest.json" manifest)))
          (save)
          (is (equal directory (verify-reference case :root root)))
          (let ((*strict* t)) (is (equal directory (verify-reference case :root root))))
          (setf (gethash "decode.f32" files) "bad-hash")
          (f::write-hf-json root "tools/mlx-gguf-reference-manifest.json" manifest)
          (signals error (verify-reference case :root root))
          (save)
          (setf (gethash "native" provenance) t)
          (f::write-hf-json directory "provenance.json" provenance)
          (save)
          (signals error (verify-reference case :root root))
          (setf (gethash "native" provenance) nil)
          (f::write-hf-json directory "provenance.json" provenance)
          (save)
          (rename-file model (merge-pathnames "absent.gguf" (uiop:pathname-directory-pathname model)))
          (is (null (verify-reference case :root root)))
          (let ((*strict* t)) (signals error (verify-reference case :root root)))
          (f::write-octets (merge-pathnames "decode.f32" directory) #(1))
          (clrhash *hashes*)
          (signals error (verify-reference case :root root))
          (signals error (read-decode-logits directory 1 1)))))))
