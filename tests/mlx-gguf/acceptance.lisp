(in-package #:cl-inference/mlx-gguf/tests)
(def-suite :cl-inference/mlx-gguf/acceptance)
(in-suite :cl-inference/mlx-gguf/acceptance)

(defun run-acceptance (&key (strict (equal "1" (uiop:getenv "CL_INFERENCE_MLX_GGUF_ACCEPTANCE_STRICT")))
                            (suite :cl-inference/mlx-gguf/acceptance))
  (let ((*strict* strict) (*hashes* (make-hash-table :test 'equal)))
    (run! suite)))

(defun check-logits (label actual expected &key top-five)
  (multiple-value-bind (maximum relative)
      (cl-inference/mlx/tests::mlx-logit-errors actual expected)
    (let ((cosine (reference-cosine actual expected)))
      (format t "~&~A: max ~,6E relative ~,6E cosine ~,9F~%" label maximum relative cosine)
      (is (<= relative 0.02d0))
      (is (>= cosine 0.9999d0))
      (when top-five
        (is (equal (cl-inference/acceptance::top-ids actual 5)
                   (cl-inference/acceptance::top-ids expected 5)))))))

(defun traced-prefill (model tokens)
  (mx:with-array-scope ()
    (let ((x (local:block-forward (local::model-block-of-type model 'local:embedding)
                                 (mx:from-data tokens (list (length tokens)) :dtype :s32)))
          (trace nil))
      (dolist (blocks (local:model-layers model))
        (dolist (block blocks) (setf x (mx:add x (local:block-forward block x :start 0 :cache nil))))
        (push (mx:slice x (list (1- (length tokens)) 0) (mx:shape x)) trace))
      (let ((logits (local:block-forward (local::model-block-of-type model 'local:lm-head) x :last-only t)))
        (apply #'mx:eval logits trace)
        (values (mx:to-vector logits :evaluate nil)
                (mapcar (lambda (array) (mx:to-vector array :evaluate nil)) (reverse trace)))))))

(defun compare-reference (case directory)
  (let* ((oracle (cl-inference/acceptance::oracle case))
         (model-kind (cl-inference/acceptance::case-option case :model)))
    (local:with-weights (weights (cl-inference/acceptance::model-path model-kind))
      (let ((model (mlx:load-mlx-model weights)) (session nil))
        (unwind-protect
             (let* ((tokenizer (local:load-tokenizer weights)) (template (local:load-chat-template weights))
                    (messages (cl-inference/acceptance::case-option case :messages))
                    (ids (if messages
                             (local:encode-chat template tokenizer messages :date "26 Jul 2024"
                               :enable-thinking (cl-inference/acceptance::case-option case :thinking))
                             (local:encode tokenizer (cl-inference/acceptance::case-option case :text))))
                    (greedy (getf oracle :greedy))
                    (stops (local:chat-template-stop-ids template tokenizer))
                    (count (+ (length greedy) (if (member (car (last greedy)) stops) 0 1)))
                    (vocabulary (first (mlx::weight-shape
                                        (local::head-output (local::model-block-of-type model 'local:lm-head)))))
                    (cached (read-decode-logits directory vocabulary count)))
               (is (equal (coerce ids 'list) (getf oracle :prompt)))
               (multiple-value-bind (logits layers) (traced-prefill model ids)
                 (check-logits (format nil "~A full prefill" case) logits (first cached) :top-five t)
                 (loop for layer in layers for index from 0
                       for expected = (cdr (assoc (format nil "l_out-~D" index) (getf oracle :trace) :test #'equal))
                       do (multiple-value-bind (maximum relative)
                              (cl-inference/mlx/tests::mlx-logit-errors layer expected)
                            (declare (ignore maximum))
                            (is (<= relative 0.02d0))
                            (is (>= (reference-cosine layer expected) 0.9999d0)))))
               (setf session (local:make-session model :tokenizer tokenizer :chat-template template :n-ctx (max 512 (+ (length ids) 16)) :n-batch (if (eq model-kind :gemma-q8) 128 7)))
               (let ((logits (local:session-prefill session ids)))
                 (check-logits (format nil "~A chunked prefill" case) (local::logits-vector logits) (first cached) :top-five t)
                 (loop for id in greedy for step from 1
                       do (is (= id (local:greedy-sampler logits)))
                          (when (<= step (1- count))
                            (setf logits (local:session-prefill session (list id)))
                            (check-logits (format nil "~A decode ~D" case step)
                                          (local::logits-vector logits) (nth step cached)))))
               (local:session-reset session)
               (multiple-value-bind (expected finish)
                   (cl-inference/mlx/tests::mlx-greedy-expectation (coerce greedy 'vector) stops)
                 (multiple-value-bind (text actual-finish actual-ids)
                     (local:generate session ids :max-tokens 8 :timeout 3600000)
                   (declare (ignore text))
                   (is (equal expected actual-ids))
                   (is (eq finish actual-finish)))))
          (when session (local:close-session session))
          (local:close-model model))))))

(defmacro define-acceptance-cases ()
  `(progn
     ,@(loop for family in '(llama qwen) append
         (loop for dtype in '(q4_0 q4_k q6_k) append
           (loop for mode in (if (eq family 'qwen) '(plain chat thinking) '(plain chat))
                 for case = (intern (format nil "~A-~A-~A" family dtype mode) :keyword)
                 collect `(test ,(intern (symbol-name case))
                            (let ((directory (verify-reference ,case)))
                              (if directory (compare-reference ,case directory)
                                  (skip "Missing ~A inputs; acceptance is not established" ,case)))))))))
(define-acceptance-cases)

(def-suite :cl-inference/gemma-mlx-gguf/acceptance :in :cl-inference/mlx-gguf/acceptance)
(in-suite :cl-inference/gemma-mlx-gguf/acceptance)

(defmacro define-gemma-gguf-acceptance-cases ()
  `(progn
     ,@(loop for name in '(plain chat system multi window)
             for case = (intern (format nil "GEMMA-~A" name) :keyword)
             collect `(test ,(intern (symbol-name case))
                        (let ((directory (verify-reference ,case)))
                          (if directory
                              (progn (cl-inference/acceptance::verify-case-oracle :gemma ,case)
                                     (compare-reference ,case directory))
                              (skip "Missing Gemma GGUF reference inputs")))))))
(define-gemma-gguf-acceptance-cases)
