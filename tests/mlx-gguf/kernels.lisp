(in-package #:cl-inference/mlx-gguf/tests)
(in-suite :cl-inference/mlx-gguf)

(defun close-values-p (actual expected)
  (and (= (length actual) (length expected))
       (every (lambda (a b) (and (not (or (float-features:float-nan-p a) (float-features:float-infinity-p a)))
                                (<= (abs (- a b)) (+ 1d-4 (* 1d-4 (abs b)))))) actual expected)))

(defun q8-golden-fixture ()
  (let ((bytes (make-array 170 :element-type '(unsigned-byte 8)))
        (expected (make-array 160 :element-type 'single-float))
        (scales '(0f0 0.5f0 -2f0 0.00006103515625f0 8f0))
        (bits '(0 #x3800 #xc000 #x0400 #x4800)))
    (loop for scale in scales for encoding in bits for block from 0
          do (setf (aref bytes (* block 34)) (logand encoding 255)
                   (aref bytes (1+ (* block 34))) (ash encoding -8))
             (dotimes (i 32)
               (let ((code (- (mod (+ (* i 73) (* block 19)) 256) 128)))
                 (setf (aref bytes (+ (* block 34) 2 i)) (logand code 255)
                       (aref expected (+ (* block 32) i)) (* scale code)))))
    (list :q8_0 bytes expected)))

(defun mlx-packed-golden-fixtures ()
  (cons (q8-golden-fixture) f::*packed-golden-blocks*))

(test independent-packed-blocks-gathers-and-projections
  (let ((before (mx:live-array-count)))
    (dolist (fixture (mlx-packed-golden-fixtures))
      (destructuring-bind (dtype bytes expected) fixture
        (multiple-value-bind (format elements block-bytes) (mlx::gguf-block-layout dtype)
          (dolist (blocks '(1 5))
            (let* ((columns (* elements blocks)) (rows (/ 5 blocks))
                   (ids (loop for i below rows collect i)))
              (mx:with-array-scope ()
                (let* ((array (mx:from-data bytes (list (length bytes)) :dtype :u8))
                       (weight (mlx::make-gguf-packed-weight :bytes array :shape (list rows columns)
                                 :format format :elements elements :block-bytes block-bytes))
                       (tokens (mx:from-data ids (list rows) :dtype :s32))
                       (mx::*evaluation-count* 0)
                       (gathered (mlx::mlx-embedding weight tokens)))
                  (is (zerop mx::*evaluation-count*))
                  (is (close-values-p (mx:to-vector gathered) expected))
                  (dolist (batch '(1 3 9))
                    (let* ((values (loop for i below (* batch columns) collect (float (* 0.01 (sin i)) 1f0)))
                           (x (mx:from-data values (list batch columns)))
                           (result (mlx::mlx-linear x weight))
                           (reference (loop for b below batch append
                                        (loop for r below rows collect
                                          (loop for c below columns sum
                                            (* (coerce (nth (+ (* b columns) c) values) 'double-float)
                                               (aref expected (+ (* r columns) c))))))))
                      (is (close-values-p (mx:to-vector result) reference))))
                  (let* ((tokens (mx:from-data (list (1- rows) 0 (1- rows)) '(3) :dtype :s32))
                         (expected (concatenate 'vector
                                    (subseq expected (* (1- rows) columns)) (subseq expected 0 columns)
                                    (subseq expected (* (1- rows) columns)))))
                    (is (close-values-p (mx:to-vector (mlx::mlx-embedding weight tokens)) expected))))))))))
    (is (= before (mx:live-array-count)))))

(test packed-lazy-cache-lifecycle
  (bridge:clear-kernel-cache)
  (mx:with-array-scope ()
    (let* ((fixture (first f::*packed-golden-blocks*))
           (bytes (second fixture))
           (array (mx:from-data bytes (list (length bytes)) :dtype :u8))
           (tokens (mx:from-data '(4 1 4) '(3) :dtype :s32))
           (weight (mlx::make-gguf-packed-weight :bytes array :shape '(5 32)
                    :format 0 :elements 32 :block-bytes 18))
           (result (mlx::mlx-embedding weight tokens)))
      (is (plusp (bridge:live-kernel-count)))
      (bridge:clear-kernel-cache)
      (is (zerop (bridge:live-kernel-count)))
      (mx:release array)
      (mx:release tokens)
      (is (= 96 (length (mx:to-vector result)))))))

(test mapped-offset-import-copy-and-malformed-scales
  (dolist (fixture (mlx-packed-golden-fixtures))
    (destructuring-bind (dtype bytes expected) fixture
      (multiple-value-bind (format elements block-bytes) (mlx::gguf-block-layout dtype)
        (declare (ignore format))
        (let ((before (mx:live-array-count)))
          (f::with-gguf-file (path (f::build-gguf :tensors
                                    `(("padding" (3) 0 ,(f::f32-octets '(1f0 2f0 3f0)))
                                      ("packed" (,elements 5) ,(f::dtype-id dtype) ,bytes))))
            (local:with-weights (source path)
              (let* ((weights (mlx::prepare-mlx-weights source))
                     (weight (local:weights-tensor weights "packed")))
                (unwind-protect
                     (progn
                       (is (eq weight (local:weights-tensor weights "packed")))
                       (is (= 1 (hash-table-count (mlx::imported-arrays weights))))
                       (let* ((raw (local:weights-tensor-bytes source "packed"))
                              (pointer (trivial-simd:vector-view-pointer (ct:tensor-storage raw))))
                         (setf (cffi:mem-aref pointer :uint8 (1- block-bytes)) 0))
                       (mx:with-array-scope ()
                         (let ((tokens (mx:from-data '(0 4) '(2) :dtype :s32)))
                           (is (close-values-p (mx:to-vector (mlx::mlx-embedding weight tokens))
                                               (concatenate 'vector (subseq expected 0 elements)
                                                            (subseq expected (* 4 elements))))))))
                  (maphash (lambda (name array) (declare (ignore name)) (mx:release array))
                           (mlx::imported-arrays weights))))))
          (is (= before (mx:live-array-count))))
        (let ((bad (copy-seq bytes)) (offset (if (eq dtype :q6_k) 209 1)))
          (setf (aref bad offset) #x7c)
          (f::with-gguf-file (path (f::build-gguf :tensors
                                    `(("packed" (,elements 5) ,(f::dtype-id dtype) ,bad))))
            (local:with-weights (source path)
              (let ((weights (mlx::prepare-mlx-weights source)))
                (signals local:architecture-error (local:weights-tensor weights "packed"))
                (is (zerop (hash-table-count (mlx::imported-arrays weights))))))))))))
