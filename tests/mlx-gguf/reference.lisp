(in-package #:cl-inference/mlx-gguf/tests)

(defvar *strict* nil)
(defvar *hashes* nil)

(defun reference-sha (path)
  (let ((key (namestring (truename path))))
    (or (gethash key *hashes*)
        (setf (gethash key *hashes*)
              (cl-inference/mlx/tests::mlx-reference-sha256 path)))))

(defun verify-reference (case &key (root (asdf:system-source-directory "cl-inference")))
  (let* ((manifest-path (merge-pathnames "tools/mlx-gguf-reference-manifest.json" root)))
    (unless (probe-file manifest-path)
      (error "Missing committed MLX GGUF reference manifest"))
    (let* ((manifest (com.inuoe.jzon:parse manifest-path))
           (name (string-downcase (symbol-name case)))
           (entry (or (gethash name manifest) (error "Unpinned GGUF acceptance case ~A" case)))
           (model (cl-inference/acceptance::case-option case :model))
           (pin (if (eq model :gemma-q8) cl-inference/acceptance::*gemma-manifest*
                    (gethash (string-downcase (symbol-name model)) cl-inference/acceptance::*quant-manifest*)))
           (path (merge-pathnames (format nil "reference/models/~A" (gethash "file" pin)) root))
           (directory (merge-pathnames (format nil "reference/oracle/~A/" name) root))
           (files (gethash "files" entry))
           (missing nil))
      (unless (equalp pin (gethash "model" entry)) (error "GGUF manifest model pin differs: ~A" case))
      (unless (equal (gethash "oracle_source_sha256" entry)
                     (reference-sha (merge-pathnames "tests/acceptance/oracle/dump-trace.cpp" root)))
        (error "GGUF oracle source differs: ~A" case))
      (if (probe-file path)
          (unless (equal (reference-sha path) (gethash "sha256" pin))
            (error "GGUF model hash mismatch: ~A" case))
          (push path missing))
      (dolist (name '("prompt.ids" "greedy.ids" "trace.txt" "top.txt" "provenance.json" "decode.f32"))
        (let ((file (merge-pathnames name directory)) (hash (gethash name files)))
          (unless hash (error "GGUF manifest lacks ~A: ~A" name case))
          (if (probe-file file)
              (unless (equal hash (reference-sha file)) (error "GGUF oracle hash mismatch: ~A" file))
              (push file missing))))
      (when missing
        (when *strict* (error "Missing required GGUF acceptance inputs: ~S" missing))
        (return-from verify-reference nil))
      (let ((actual (com.inuoe.jzon:parse (merge-pathnames "provenance.json" directory))))
        (dolist (field (if (eq model :gemma-q8)
                           '("sha256" "revision" "reference_sha256" "llama_cpp" "dtype")
                           '("sha256" "source_sha256" "llama_cpp" "dtype")))
          (unless (equal (gethash field pin) (gethash field actual))
            (error "GGUF oracle provenance mismatch: ~A ~A" case field)))
        (multiple-value-bind (native present) (gethash "native" actual)
          (unless (and present (null native)) (error "GGUF requires F32-dequantized references"))))
      directory)))

(defun read-decode-logits (directory vocabulary count)
  (with-open-file (stream (merge-pathnames "decode.f32" directory) :element-type '(unsigned-byte 8))
    (unless (= (file-length stream) (* 4 vocabulary count))
      (error "Malformed cached-decode reference dimensions"))
    (loop repeat count collect
      (let ((bytes (make-array (* 4 vocabulary) :element-type '(unsigned-byte 8)))
            (values (make-array vocabulary :element-type 'single-float)))
        (read-sequence bytes stream)
        (cffi:with-pointer-to-vector-data (pointer bytes)
          (dotimes (i vocabulary) (setf (aref values i) (cffi:mem-aref pointer :float i))))
        values))))


(defun reference-cosine (actual expected)
  (let ((a (map 'vector (lambda (v) (coerce v 'double-float)) actual))
        (b (map 'vector (lambda (v) (coerce v 'double-float)) expected)))
    (cl-inference/acceptance::cosine a b)))
