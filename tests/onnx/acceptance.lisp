(in-package #:cl-inference/onnx/tests)
(def-suite :cl-inference/onnx/acceptance)
(defun run-acceptance () (run! :cl-inference/onnx/acceptance))
(in-suite :cl-inference/onnx/acceptance)

(defun reference-file (name)
  (asdf:system-relative-pathname "cl-inference" (concatenate 'string "reference/onnx/" name)))
(defun sha256-file (path)
  (subseq (uiop:run-program (list "shasum" "-a" "256" (namestring path)) :output :string) 0 64))
(defun verified-reference ()
  (let ((oracle (reference-file "oracle.json"))
        (manifest-path (asdf:system-relative-pathname "cl-inference" "tests/onnx/model.json")))
    (unless (probe-file oracle)
      (if (equal "1" (uiop:getenv "CL_INFERENCE_ONNX_ACCEPTANCE_STRICT"))
          (error "Prepare the pinned ONNX reference before strict acceptance")
          (return-from verified-reference nil)))
    (let ((manifest (hf:read-json-file manifest-path)) (data (hf:read-json-file oracle)))
      (unless (equal (gethash "manifest_sha256" data) (sha256-file manifest-path))
        (error "ONNX reference manifest mismatch"))
      (unless (equal (ox:runtime-version) (gethash "runtime" manifest)) (error "ONNX runtime version mismatch"))
      (unless (equal (gethash "onnxruntime" (gethash "versions" data)) (gethash "runtime" manifest))
        (error "ONNX oracle version mismatch"))
      (unless (equal (string-trim '(#\Space #\Newline) (uiop:read-file-string
                                                      (asdf:system-relative-pathname "cl-inference" "tests/onnx/oracle.sha256")))
                     (sha256-file oracle))
        (error "ONNX oracle hash mismatch"))
      (maphash (lambda (name hash)
                 (unless (equal hash (sha256-file (reference-file (concatenate 'string "smollm2/" name))))
                   (error "ONNX asset hash mismatch: ~A" name)))
               (gethash "files" manifest))
      data)))
(defun neutral-messages (messages)
  (loop for message across messages
        collect (list :role (intern (string-upcase (gethash "role" message)) :keyword)
                      :content (gethash "content" message))))
(defun logits-match-p (actual expected)
  (and (= (aref (ct:tensor-shape actual) 1) (length expected))
       (loop for reference across expected for i from 0
             always (<= (abs (- (ct:tref actual 0 i) reference)) (+ 1e-4 (* 1e-4 (abs reference)))))))

(test pinned-smollm2-prompts-logits-and-generation
  (block acceptance
  (let ((reference (verified-reference)))
    (unless reference (skip "Prepare ONNX reference assets; skipped checks do not establish support")
      (return-from acceptance nil))
    (onnx:with-onnx-backend (backend (reference-file "smollm2/") :graph "onnx/model.onnx" :n-batch 16)
      (let ((tokenizer (local::backend-tokenizer backend)) (template (local::backend-template backend))
            (model (local::backend-model backend)))
        (loop for case across (gethash "cases" reference)
              for messages = (neutral-messages (gethash "messages" case))
              for ids = (local:encode-chat template tokenizer messages)
              do (is (equalp ids (gethash "prompt_ids" case)))
                 (let ((cache (local:make-model-cache model 4096)))
                   (unwind-protect
                        (progn
                          (is (logits-match-p (local:model-forward model ids :cache cache) (gethash "initial_logits" case)))
                          (let ((generated (gethash "generated_ids" case)))
                            (local:model-forward model (vector (aref generated 0)) :start (length ids) :cache cache)
                            (is (logits-match-p
                                 (local:model-forward model (vector (aref generated 1)) :start (1+ (length ids)) :cache cache)
                                 (gethash "cached_logits" case)))))
                     (local:close-cache cache)))
                 (let* ((session (local::backend-new-session backend)) (generated nil))
                   (unwind-protect
                        (multiple-value-bind (text finish ids usage)
                            (local:generate session (gethash "prompt_ids" case) :prompt-p t :max-tokens 8)
                          (declare (ignore finish usage))
                          (setf generated text)
                          (is (equalp (coerce ids 'vector) (gethash "generated_ids" case))))
                     (local:close-session session))
                   (is (equal generated (gethash "text" case))))
                 (let* ((events nil)
                        (reply (ci:complete backend :messages messages :temperature 0 :max-tokens 8
                                                    :stream (lambda (event) (push event events)))))
                   (is (success-p reply))
                   (is (equal (gethash "text" case) (reply-text reply)))
                   (is (= 1 (count :done events :key (lambda (event) (getf event :type)))))))))))

)

(test pinned-smollm2-tokenizer-parity
  (let ((reference (verified-reference)))
    (if (null reference) (skip "Prepare ONNX reference assets")
        (onnx:with-onnx-backend (backend (reference-file "smollm2/") :graph "onnx/model.onnx")
          (let ((tokenizer (local::backend-tokenizer backend)))
            (loop for case across (gethash "tokenizer" reference)
                  for ids = (local:encode tokenizer (gethash "text" case) :special t)
                  do (is (equalp ids (gethash "ids" case)))
                     (is (equal (local:decode tokenizer ids :special t) (gethash "decoded" case)))))))))
