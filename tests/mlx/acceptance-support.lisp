(in-package #:cl-inference/mlx/tests)

(defvar *mlx-acceptance-strict* nil)
(defvar *mlx-reference-hashes* nil)

(defun mlx-reference-root ()
  (asdf:system-relative-pathname "cl-inference" "reference/mlx/"))

(defun mlx-reference-manifest ()
  (st::read-json-file (asdf:system-relative-pathname "cl-inference" "tools/mlx-reference-manifest.json")))

(defun mlx-reference-sha256 (path)
  (let ((key (namestring (truename path))))
    (or (and *mlx-reference-hashes* (gethash key *mlx-reference-hashes*))
        (let ((hash (subseq (uiop:run-program (list "shasum" "-a" "256" key) :output :string) 0 64)))
          (when *mlx-reference-hashes* (setf (gethash key *mlx-reference-hashes*) hash))
          hash))))

(defun mlx-reference-inputs (directory)
  (let* ((input (st::resolve-input directory))
         (shards (st::input-shards input directory)))
    (append (when (st::index-path-p input) (list input)) shards
            (loop for name in '("config.json" "tokenizer.json" "tokenizer_config.json"
                                "generation_config.json" "special_tokens_map.json" "chat_template.jinja")
                  for path = (merge-pathnames name directory)
                  when (probe-file path) collect path))))

(defun mlx-missing-inputs (name missing)
  (when missing
    (when *mlx-acceptance-strict*
      (error "Missing ~A inputs: ~{~A~^, ~}; acceptance is not established" name missing))
    missing))

(defun verify-mlx-reference (name root manifest)
  (let* ((entry (or (gethash name manifest) (error "No pinned reference manifest for ~A" name)))
         (files (gethash "files" entry))
         (directory (merge-pathnames (format nil "~A/" name) root))
         (oracle (merge-pathnames (format nil "~A-oracle.json" name) root))
         (missing nil))
    (unless (and (hash-table-p files) (plusp (hash-table-count files)))
      (error "Empty reference manifest for ~A" name))
    (maphash
     (lambda (relative hash)
       (unless (or (equal relative (format nil "~A-oracle.json" name))
                   (and (uiop:string-prefix-p (format nil "~A/" name) relative)
                        (not (member :up (pathname-directory relative)))))
         (error "Reference manifest path escapes ~A: ~A" name relative))
       (let ((path (merge-pathnames relative root)))
         (if (probe-file path)
             (progn
               (unless (uiop:subpathp (truename path) (truename root))
                 (error "Reference input escapes root: ~A" path))
               (unless (equal hash (mlx-reference-sha256 path))
                 (error "SHA-256 mismatch for ~A" path)))
             (push relative missing))))
     files)
    (when (mlx-missing-inputs name missing) (return-from verify-mlx-reference nil))
    (dolist (required '("config.json" "tokenizer.json" "tokenizer_config.json"))
      (unless (gethash (format nil "~A/~A" name required) files)
        (error "Reference manifest lacks ~A/~A" name required)))
    (unless (gethash (format nil "~A-oracle.json" name) files)
      (error "Reference manifest lacks ~A oracle" name))
    (let ((inputs (append (mlx-reference-inputs directory) (list oracle))))
      (unless (= (length inputs) (hash-table-count files))
        (error "Reference file set differs for ~A" name))
      (dolist (path inputs)
        (unless (gethash (enough-namestring (truename path) (truename root)) files)
          (error "Unpinned reference input ~A" path))))
    (let ((data (st::read-json-file oracle)))
      (unless (equalp (gethash "metadata" entry) (gethash "metadata" data))
        (error "Oracle provenance differs for ~A" name))
      data)))

(defun mlx-logit-errors (actual expected)
  (unless (and (vectorp actual) (vectorp expected)
               (plusp (length expected)) (= (length actual) (length expected)))
    (error "Logit dimensions differ or are empty"))
  (let ((maximum 0d0) (difference 0d0) (norm 0d0))
    (loop for a across actual for e across expected
          do (dolist (value (list a e))
               (unless (and (realp value)
                            (not (and (floatp value)
                                      (or (float-features:float-nan-p value)
                                          (float-features:float-infinity-p value)))))
                 (error "Non-finite or non-numeric reference logit")))
             (let ((delta (- (coerce a 'double-float) (coerce e 'double-float))))
               (setf maximum (max maximum (abs delta)))
               (incf difference (* delta delta))
               (incf norm (expt (coerce e 'double-float) 2))))
    (unless (plusp norm) (error "Reference logits have zero norm"))
    (values maximum (sqrt (/ difference norm)))))

(defun mlx-greedy-expectation (ids stops)
  (let ((stop (position-if (lambda (id) (member id stops)) ids)))
    (values (coerce (subseq ids 0 stop) 'list) (if stop :stop :length))))
