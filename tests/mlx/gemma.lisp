(in-package #:cl-inference/mlx/tests)
(in-suite :cl-inference/mlx)

(defun gemma-traced-prefill (model tokens)
  (mx:with-array-scope ()
    (let ((x (local:block-forward (local::model-block-of-type model 'local:embedding)
                                 (mx:from-data tokens (list (length tokens)) :dtype :s32)))
          (trace nil))
      (dolist (blocks (local:model-layers model))
        (dolist (block blocks) (setf x (mx:add x (local:block-forward block x :start 0 :cache nil))))
        (push (mx:slice x (list (1- (length tokens)) 0) (mx:shape x)) trace))
      (let ((logits (local:block-forward (local::model-block-of-type model 'local:lm-head) x :last-only t)))
        (apply #'mx:eval logits trace)
        (values (mx:to-vector logits :evaluate nil)
                (mapcar (lambda (array) (mx:to-vector array :evaluate nil)) (reverse trace)))))))

(test gemma-hf-mlx-logits-window-cache-and-lifetime
  (dolist (dtype '(:f32 :f16 :bf16))
    (dolist (tied '(nil t))
      (let* ((spec (f::gemma-spec :dtype dtype :tied tied :layers 3 :pattern 2 :window 3))
             (table (f::weight-table spec)) (tokens '(3 0 5 2 6))
             (before (mx:live-array-count)))
        (f::with-hf-directory (directory)
          (f::write-gemma-hf-model directory spec table)
          (local:with-weights (weights directory)
            (let* ((model (mlx:load-mlx-model weights))
                   (session (local:make-session model :n-ctx 32 :n-batch 2)))
              (unwind-protect
                   (progn
                     (is (f::rows-close-p (f::tensor-rows (local:model-forward model tokens :all-logits t))
                                          (f::ref-logits table spec :neox tokens)))
                     (local:session-prefill session '(3 0 5))
                     (is (f::rows-close-p (f::tensor-rows (local:session-prefill session '(2 6)))
                                          (last (f::ref-logits table spec :neox tokens))))
                     (let ((handles (mx:live-array-count)))
                       (dotimes (i 3)
                         (local:session-reset session)
                         (local:session-prefill session tokens))
                       (is (= handles (mx:live-array-count)))))
                (local:close-session session)
                (local:close-model model)))))
        (is (= before (mx:live-array-count)))))))

(test gemma-hf-mlx-client-prefix-streaming-and-cancellation
  (let ((before (mx:live-array-count)))
    (f::check-gemma-hf-client #'mlx:make-mlx-backend #'mlx:close-mlx-backend)
    (is (= before (mx:live-array-count)))))

(test gemma-image-token-metadata-does-not-enable-image-inference
  (let ((before (mx:live-array-count)))
    (dolist (variant '(:image :ordinary :other))
      (f::with-hf-directory (directory)
        (f::write-gemma-hf-chat-fixture directory)
        (let* ((pipeline (cl-inference/hf:read-json-file (merge-pathnames "tokenizer.json" directory)))
               (vocab (gethash "vocab" (gethash "model" pipeline)))
               (id (hash-table-count vocab))
               (name (if (eq variant :other) "<other>" "<image_soft_token>"))
               (entry (alexandria:plist-hash-table
                       (list "id" id "content" name "special" (not (eq variant :ordinary))
                             "single_word" nil "lstrip" nil "rstrip" nil "normalized" nil) :test 'equal)))
          (setf (gethash name vocab) id
                (gethash "added_tokens" pipeline) (concatenate 'vector (gethash "added_tokens" pipeline) (vector entry)))
          (f::write-hf-json directory "tokenizer.json" pipeline)
          (local:with-weights (weights directory)
            (if (eq variant :image)
                (mlx:with-mlx-backend (backend weights :n-ctx 128)
                  (is (not (ci:result-error-p
                            (ci:complete backend :messages '((:role :user :content "<image_soft_token>"))
                                         :temperature 0 :max-tokens 1))))
                  (let ((session (local:make-session (local::backend-model backend) :n-ctx 128)))
                    (unwind-protect
                         (signals local:session-error (local:session-prefill session (list id)))
                      (local:close-session session))))
                (signals local:architecture-error (mlx:make-mlx-backend weights)))))))
    (is (= before (mx:live-array-count)))))
