(in-package #:cl-inference/mlx/tests)
(in-suite :cl-inference/mlx)

(test mlx-float-models-and-cached-decoding
  (dolist (arch '("llama" "qwen3"))
    (dolist (dtype '(:f32 :f16 :bf16))
      (dolist (tied '(nil t))
        (let* ((spec (f::spec* :qk-norm (equal arch "qwen3") :head-dim 8 :rope-dims 8 :dtype dtype :tied tied))
               (table (f::weight-table spec)) (tokens '(3 0 5 2 6))
               (before (mx:live-array-count)))
          (f::with-hf-directory (directory)
            (f::write-hf-model directory arch spec table)
            (local:with-weights (w directory)
              (let* ((model (mlx:load-mlx-model w)) (session (local:make-session model :n-batch 2)))
                (unwind-protect
                     (progn
                       (is (f::rows-close-p (f::tensor-rows (local:model-forward model tokens :all-logits t))
                                           (f::ref-logits table spec :neox tokens)))
                       (let ((mx::*evaluation-count* 0))
                         (local:session-prefill session '(3 0 5))
                         (is (= 2 mx::*evaluation-count*))
                         (is (f::rows-close-p (f::tensor-rows (local:session-prefill session '(2 6)))
                                             (last (f::ref-logits table spec :neox tokens))))
                         (is (= 3 mx::*evaluation-count*)))
                       (let ((arrays (mx:live-array-count)))
                         (dotimes (i 12)
                           (local:session-reset session)
                           (local:session-prefill session tokens))
                         (is (= arrays (mx:live-array-count))))
                       (local:session-reset session)
                       (is (f::rows-close-p (f::tensor-rows (local:session-prefill session '(3 0)))
                                           (last (f::ref-logits table spec :neox '(3 0)))))
                       (signals local:context-overflow
                         (local:session-prefill session (make-list 500 :initial-element 1))))
                  (local:close-session session)
                  (local:close-model model)
                  (local:close-model model)))))
          (is (= before (mx:live-array-count))))))))

(defun quantize-fixture-row (row group-size)
  (let ((packed nil) (scales nil) (biases nil) (decoded nil))
    (loop for start from 0 below (length row) by group-size
          for values = (subseq row start (+ start group-size))
          for low = (reduce #'min values) for high = (reduce #'max values)
          for scale = (if (= low high) 1f0 (/ (- high low) 15f0))
          do (push scale scales) (push low biases)
             (let ((codes (mapcar (lambda (x) (max 0 (min 15 (round (/ (- x low) scale))))) values)))
               (loop for offset from 0 below group-size by 8
                     do (push (loop for i below 8 sum (ash (nth (+ offset i) codes) (* 4 i))) packed))
               (dolist (code codes) (push (+ low (* scale code)) decoded))))
    (values (nreverse packed) (nreverse scales) (nreverse biases) (nreverse decoded))))

(defun write-quantized-fixture (directory arch spec table &key mixed)
  (let ((tensors nil))
    (maphash
     (lambda (name entry)
       (unless (equal name "rope_freqs.weight")
         (let* ((hf (f::hf-tensor-name name)) (shape (car entry)) (values (cdr entry)))
           (if (and (= (length shape) 2) (or (not mixed) (search "embd" name) (search "attn_q.weight" name)))
               (let ((packed nil) (scales nil) (biases nil) (decoded nil) (columns (second shape)))
                 (loop for row below (first shape)
                       do (multiple-value-bind (p s b d)
                              (quantize-fixture-row (subseq values (* row columns) (* (1+ row) columns)) 32)
                            (setf packed (append packed p) scales (append scales s)
                                  biases (append biases b) decoded (append decoded d))))
                 (setf (cdr entry) decoded)
                 (let ((bytes (f::make-buffer)) (base (subseq hf 0 (- (length hf) 7))))
                   (dolist (value packed) (f::put-uint bytes value 4))
                   (push (list hf (list (first shape) (/ columns 8)) "U32" bytes) tensors)
                   (push (list (concatenate 'string base ".scales") (list (first shape) (/ columns 32)) "F32" (f::f32-octets scales)) tensors)
                   (push (list (concatenate 'string base ".biases") (list (first shape) (/ columns 32)) "F32" (f::f32-octets biases)) tensors)))
               (push (list hf shape "F32" (f::f32-octets values)) tensors))))) table)
    (f::write-octets (merge-pathnames "model.safetensors" directory) (f::build-safetensors (nreverse tensors)))
    (f::write-hf-json directory "config.json"
                     (f::hf-config arch spec "quantization" (ci::json-object "bits" 4 "group_size" 32)))))

(test mlx-quantized-models-embedding-and-tied-head
  (dolist (arch '("llama" "qwen3"))
    (dolist (tied '(nil t))
      (dolist (mixed '(nil t))
        (let* ((spec (f::spec* :dim 32 :heads 2 :kv 1 :head-dim 16 :rope-dims 16 :ffn 64
                             :tied tied :qk-norm (equal arch "qwen3")))
               (table (f::weight-table spec)) (before (mx:live-array-count)))
          (f::with-hf-directory (directory)
            (write-quantized-fixture directory arch spec table :mixed mixed)
            (local:with-weights (w directory)
              (signals local:architecture-error (local:load-model w))
              (let* ((model (mlx:load-mlx-model w)) (session (local:make-session model :n-batch 2)))
                (unwind-protect
                     (progn
                       (is (f::rows-close-p (f::tensor-rows (local:model-forward model '(1 2 3) :all-logits t))
                                           (f::ref-logits table spec :neox '(1 2 3))))
                       (local:session-prefill session '(1 2))
                       (is (f::rows-close-p (f::tensor-rows (local:session-prefill session '(3)))
                                           (last (f::ref-logits table spec :neox '(1 2 3))))))
                  (local:close-session session) (local:close-model model)))))
          (is (= before (mx:live-array-count))))))))

(test mlx-rope-scaling-and-failed-load-cleanup
  (let* ((spec (f::spec* :head-dim 8 :rope-dims 8 :theta 10000f0 :freqs t))
         (table (f::weight-table spec)) (before (mx:live-array-count)))
    (setf (gethash "rope_freqs.weight" table) (cons '(4) '(1f0 2.3391168f0 8f0 8f0)))
    (f::with-hf-directory (directory)
      (f::write-hf-model directory "llama" spec table "rope_scaling" (f::llama3-scaling))
      (local:with-weights (w directory)
        (let ((model (mlx:load-mlx-model w)))
          (unwind-protect
               (is (f::rows-close-p (f::tensor-rows (local:model-forward model '(1 2 3) :all-logits t))
                                   (f::ref-logits table spec :neox '(1 2 3))))
            (local:close-model model))))
      (remhash "blk.1.attn_k.weight" table)
      (f::write-hf-model directory "llama" spec table)
      (local:with-weights (w directory) (signals local:weights-error (mlx:load-mlx-model w))))
    (is (= before (mx:live-array-count)))))

(test mlx-rejects-unsupported-quantization
  (let* ((spec (f::spec* :dim 32 :heads 2 :kv 1 :head-dim 16 :rope-dims 16 :ffn 64))
         (before (mx:live-array-count)))
    (f::with-hf-directory (directory)
      (write-quantized-fixture directory "llama" spec (f::weight-table spec))
      (dolist (config (list (ci::json-object "bits" 8 "group_size" 32)
                           (ci::json-object "bits" 4 "group_size" 24)
                           (ci::json-object "bits" 4 "group_size" 32 "mode" "mxfp4")))
        (f::write-hf-json directory "config.json" (f::hf-config "llama" spec "quantization" config))
        (local:with-weights (w directory) (signals local:architecture-error (mlx:load-mlx-model w)))))
    (is (= before (mx:live-array-count)))))

(test mlx-q8-cache-prefix-reuse-and-cleanup
  (dolist (arch '("llama" "qwen3"))
    (dolist (cache-type '(:f32 :q8))
      (let* ((spec (f::spec* :head-dim 8 :rope-dims 8 :qk-norm (equal arch "qwen3")))
             (before (mx:live-array-count)))
        (f::with-hf-directory (directory)
          (f::write-hf-model directory arch spec (f::weight-table spec))
          (local:with-weights (weights directory)
            (let* ((model (mlx:load-mlx-model weights))
                   (session (local:make-session model :cache-type cache-type :n-batch 2))
                   (fresh (local:make-session model :cache-type cache-type :n-batch 512)))
              (unwind-protect
                   (progn
                     (loop for prompt in '((3 0 5) (3 0 5) (3 0 5 2 6) (3 0) (3 4 2) (1 2))
                           for expected in '(0 2 3 1 1 0)
                           do (is (= expected
                                     (getf (nth-value 3 (local:generate session prompt :prompt-p t :max-tokens 0))
                                           :cached-prompt-tokens)))
                              (let ((cached (local:session-prefill session '(4))))
                                (local:session-reset fresh)
                                (is (f::rows-close-p (f::tensor-rows cached)
                                                     (f::tensor-rows (local:session-prefill fresh (append prompt '(4)))))))
                              (setf (local:session-position session) (length prompt)
                                    (fill-pointer (local::session-tokens session)) (length prompt)))
                     (let ((arrays (mx:live-array-count)))
                       (dotimes (i 8)
                         (local:generate session '(1 2) :prompt-p t :max-tokens 1)
                         (local:generate fresh '(1 2) :prompt-p t :max-tokens 1))
                       (is (= arrays (mx:live-array-count))))
                     (let ((f::*cache-forward-probe*
                             (lambda (tokens start) (declare (ignore tokens start)) (error "forward failed"))))
                       (signals error (local:session-prefill session '(3))))
                     (is (zerop (local:session-position session)))
                     (let ((arrays (mx:live-array-count)) (f::*cache-layer-failure* t))
                       (signals error (local:session-prefill session '(3)))
                       (is (= arrays (mx:live-array-count))))
                     (is (f::rows-close-p (f::tensor-rows (local:session-prefill session '(2 1)))
                                          (progn (local:session-reset fresh)
                                                 (f::tensor-rows (local:session-prefill fresh '(2 1)))))))
                (local:close-session session)
                (local:close-session fresh)
                (local:close-model model)))))
        (is (= before (mx:live-array-count)))))))

(test mlx-q8-codec-agrees-with-cpu
  (let* ((dim 35)
         (values (loop for i below (* 2 3 dim) collect (coerce (* 7 (sin (+ i 0.3d0))) 'single-float)))
         (buffer (local::make-q8-buffer (list 2 3 dim))))
    (local::store-q8-rows buffer (ct:reshape (ct:from-data values) (list 2 3 dim)) 0)
    (mx:with-array-scope ()
      (multiple-value-bind (codes scales) (mx:symmetric-quantize (mx:from-data values (list 2 3 dim)))
        (is (equalp (map 'vector #'float (local::q8-buffer-bytes buffer))
                    (mx:to-vector (mx:astype codes :f32))))
        (is (equalp (local::q8-buffer-scales buffer) (mx:to-vector scales)))))))
