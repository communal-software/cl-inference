(in-package #:cl-inference/mlx/tests)
(def-suite :cl-inference/mlx/acceptance)
(in-suite :cl-inference/mlx/acceptance)

(defun run-acceptance (&key (strict (equal "1" (uiop:getenv "CL_INFERENCE_MLX_ACCEPTANCE_STRICT"))))
  (let ((*mlx-acceptance-strict* strict)
        (*mlx-reference-hashes* (make-hash-table :test 'equal)))
    (run! :cl-inference/mlx/acceptance)))

(defun check-mlx-logits (name actual expected)
  (multiple-value-bind (maximum relative) (mlx-logit-errors (local::logits-vector actual) expected)
    (format t "~&~A: max error ~E, relative L2 ~E~%" name maximum relative)
    (is (< maximum 0.005d0))
    (is (< relative 0.0005d0))))

(defun compare-mlx-oracle (directory oracle)
  (local:with-weights (weights directory)
    (let ((model (mlx:load-mlx-model weights)) (session nil))
      (unwind-protect
           (let* ((tokenizer (local:load-tokenizer weights))
                  (template (local:load-chat-template weights))
                  (metadata (gethash "metadata" oracle))
                  (llama (equal "llama" (gethash "architecture" metadata)))
                  (date (gethash "date" metadata))
                  (messages '((:role :user :content "What is the capital of France?")))
                  (body (local:render-chat template messages :add-generation-prompt t :date date))
                  (prompt (if llama (concatenate 'string "<|begin_of_text|>" body) body))
                  (ids (local:encode-chat template tokenizer messages :date date))
                  (greedy (gethash "greedy" oracle))
                  (cached (gethash "cached_logits" oracle)))
             (setf session (local:make-session model :tokenizer tokenizer :chat-template template
                                              :n-ctx 256 :n-batch 7))
             (is (equal (gethash "prompt" oracle) prompt))
             (is (equalp (gethash "ids" oracle) ids))
             (when llama
               (let ((bos (local:token-id tokenizer "<|begin_of_text|>")))
                 (is (= bos (aref ids 0)))
                 (is (= 1 (count bos ids)))))
             (loop for entry across (gethash "encodings" oracle)
                   do (is (equalp (gethash "ids" entry)
                                  (local:encode tokenizer (gethash "text" entry) :special t
                                                :add-bos (eq t (gethash "add_bos" entry))))))
             (unless (and (= 8 (length greedy)) (= 8 (length cached)))
               (error "Oracle needs eight cached greedy steps"))
             (let ((logits (local:session-prefill session ids)))
               (check-mlx-logits directory logits (gethash "logits" oracle))
               (loop for expected-id across greedy for expected-logits across cached
                     for step from 1 for token = (local:greedy-sampler logits)
                     do (is (= expected-id token))
                        (setf logits (local:session-prefill session (list token)))
                        (check-mlx-logits (format nil "~A decode ~D" directory step) logits expected-logits)))
             (local:session-reset session)
             (multiple-value-bind (expected finish)
                 (mlx-greedy-expectation greedy (local:chat-template-stop-ids template tokenizer))
               (multiple-value-bind (text actual-finish actual-ids)
                   (local:generate session ids :max-tokens 8 :timeout 3600000)
                 (declare (ignore text))
                 (is (equal expected actual-ids))
                 (is (eq finish actual-finish)))))
        (when session (local:close-session session))
        (local:close-model model)))))

(defmacro define-mlx-acceptance (name)
  `(test ,(intern (string-upcase (format nil "MLX-~A-REAL-MODEL-ACCEPTANCE" name)))
     (let* ((root (mlx-reference-root))
            (oracle (verify-mlx-reference ,name root (mlx-reference-manifest))))
       (if oracle
           (compare-mlx-oracle (merge-pathnames ,(format nil "~A/" name) root) oracle)
           (skip "Missing ~A inputs; acceptance is not established" ,name)))))

(define-mlx-acceptance "qwen-float")
(define-mlx-acceptance "qwen-4bit")
(define-mlx-acceptance "llama-float")
(define-mlx-acceptance "llama-4bit")
