(in-package #:cl-inference/mlx/tests)
(def-suite :cl-inference/mlx/acceptance)
(in-suite :cl-inference/mlx/acceptance)

(defun run-acceptance () (run! :cl-inference/mlx/acceptance))

(defun mlx-reference-root ()
  (merge-pathnames "reference/mlx/" (asdf:system-source-directory "cl-inference")))

(defun compare-mlx-oracle (directory oracle)
  (local:with-weights (w directory)
    (let* ((model (mlx:load-mlx-model w))
           (tokenizer (local:load-tokenizer w)) (template (local:load-chat-template w))
           (session (local:make-session model :n-ctx 256 :n-batch 7)))
      (unwind-protect
           (progn
             (let* ((messages '((:role :user :content "What is the capital of France?")))
                    (prompt (local:render-chat template messages :add-generation-prompt t))
                    (ids (local:encode-chat template tokenizer messages)))
               (is (equal (gethash "prompt" oracle) prompt))
               (is (equalp (gethash "ids" oracle) ids))
               (loop for entry across (gethash "encodings" oracle)
                     do (is (equalp (aref entry 1) (local:encode tokenizer (aref entry 0) :special t)))))
             (let* ((logits (local:session-prefill session (gethash "ids" oracle)))
                    (actual (local::logits-vector logits)) (expected (gethash "logits" oracle))
                    (maximum (loop for a across actual for e across expected maximize (abs (- a e))))
                    (relative (sqrt (/ (loop for a across actual for e across expected sum (expt (- a e) 2))
                                       (loop for e across expected sum (* e e))))))
               (format t "~&~A: max error ~E, relative L2 ~E~%" directory maximum relative)
               (is (< maximum 0.005))
               (is (< relative 0.0005))
               (loop for expected-id across (gethash "greedy" oracle)
                     for token = (local:greedy-sampler logits)
                     do (is (= expected-id token))
                        (setf logits (local:session-prefill session (list token))))))
        (local:close-session session) (local:close-model model)))))

(test mlx-qwen-real-model-acceptance
  (dolist (name '("qwen-float" "qwen-4bit"))
    (let* ((root (mlx-reference-root))
           (directory (merge-pathnames (format nil "~A/" name) root))
           (path (merge-pathnames (format nil "~A-oracle.json" name) root)))
      (if (and (probe-file (merge-pathnames "model.safetensors" directory)) (probe-file path))
          (compare-mlx-oracle directory (st::read-json-file path))
          (skip "Missing ~A model or oracle; acceptance is not established" name)))))
