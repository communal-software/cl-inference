(in-package #:cl-inference/local/tests)
(in-suite :cl-inference/local)

(defvar *cache-forward-probe* nil)
(defvar *cache-layer-failure* nil)

(defmethod local:model-forward :around ((model local:model) tokens &key (start 0) &allow-other-keys)
  (when *cache-forward-probe* (funcall *cache-forward-probe* tokens start))
  (call-next-method))

(defmethod local:block-forward :around ((block local:attention) x &key &allow-other-keys)
  (let ((result (call-next-method)))
    (when (and *cache-layer-failure* (= 1 (local:block-layer block)))
      (error "Failed after writing a layer's cache"))
    result))

(test complete-prompts-reuse-only-matching-tokens
  (dolist (cache-type '(:f32 :q8))
    (dolist (batch '(1 2 512))
      (with-session (session model :cache-type cache-type :n-batch batch) ()
        (let ((fresh (local:make-session model :cache-type cache-type :n-batch batch)))
          (unwind-protect
               (loop for prompt in '((3 0 5) (3 0 5) (3 0 5 2 6) (3 0) (3 4 2) (1 2))
                     for expected-cached in '(0 2 3 1 1 0)
                     do (let ((calls nil))
                          (multiple-value-bind (text finish ids usage)
                              (let ((*cache-forward-probe*
                                      (lambda (tokens start) (push (list (length tokens) start) calls))))
                                (local:generate session prompt :prompt-p t :max-tokens 0))
                            (declare (ignore text ids))
                            (is (eq finish :length))
                            (is (= expected-cached (getf usage :cached-prompt-tokens)))
                            (is (= (length prompt) (getf usage :prompt-tokens)))
                            (is (= (- (length prompt) expected-cached) (reduce #'+ calls :key #'first)))
                            (is (= expected-cached (second (car (last calls)))))))
                        (let ((cached (local:session-prefill session '(4))))
                          (local:session-reset fresh)
                          (is (rows-close-p (tensor-rows cached)
                                            (tensor-rows (local:session-prefill fresh (append prompt '(4)))))))
                        (setf (local:session-position session) (length prompt)
                              (fill-pointer (local::session-tokens session)) (length prompt)))
            (local:close-session fresh)))))))

(test prefix-reuse-includes-generated-tokens-and-can-be-disabled
  (with-session (session model) ()
    (local:generate session '(3 0) :sampler (script-sampler '(5 2)) :max-tokens 2)
    (let ((usage (nth-value 3 (local:generate session '(3 0 5 2 6) :prompt-p t :max-tokens 0))))
      (is (= 4 (getf usage :cached-prompt-tokens))))
    (is (= 0 (getf (nth-value 3 (local:generate session '(3 0 5 2 6) :prompt-p t
                                                               :reuse-prefix nil :max-tokens 0))
                    :cached-prompt-tokens)))
    (local:session-reset session)
    (is (zerop (length (local::session-tokens session))))
    (is (= 0 (getf (nth-value 3 (local:generate session '(3 0) :prompt-p t :max-tokens 0))
                    :cached-prompt-tokens)))))

(test prefix-reuse-validates-before-changing-history
  (with-session (session model :n-ctx 8) ()
    (local:session-prefill session '(3 0 5))
    (signals local:context-overflow
      (local:generate session (make-list 9 :initial-element 1) :prompt-p t))
    (signals local:session-error (local:generate session #() :prompt-p t))
    (let ((cancel (ci:make-cancel-token)))
      (ci:cancel cancel)
      (is (equal '(:error :cancelled)
                 (nth-value 1 (local:generate session '(1 2) :prompt-p t :cancel cancel)))))
    (is (equalp #(3 0 5) (local::session-tokens session)))
    (let ((*cache-forward-probe* (lambda (tokens start) (declare (ignore tokens start)) (error "forward failed"))))
      (signals error (local:session-prefill session '(2))))
    (is (= 0 (local:session-position session)))
    (is (zerop (length (local::session-tokens session))))
    (is (rows-close-p (tensor-rows (local:session-prefill session '(1 2)))
                      (tensor-rows (local:model-forward model '(1 2)))))))

(test committed-token-history-survives-cooperative-prefill-interruption
  (with-session (session model :n-batch 2) ()
    (let ((calls 0))
      (local:session-prefill session '(3 0 5 2)
                             :check (lambda () (when (= 2 (incf calls)) (ci:fail :cancelled)))))
    (is (equalp #(3 0) (local::session-tokens session)))
    (is (= 2 (getf (nth-value 3 (local:generate session '(3 0 5 2) :prompt-p t :max-tokens 0))
                    :cached-prompt-tokens)))))

(test partial-model-failures-invalidate-the-token-history
  (dolist (cache-type '(:f32 :q8))
    (with-session (session model :cache-type cache-type) ()
      (local:session-prefill session '(3 0 5))
      (let ((*cache-layer-failure* t))
        (signals error (local:session-prefill session '(2))))
      (is (zerop (local:session-position session)))
      (is (zerop (length (local::session-tokens session))))
      (let ((fresh (local:make-session model :cache-type cache-type)))
        (unwind-protect
             (is (rows-close-p (tensor-rows (local:session-prefill session '(2 1)))
                               (tensor-rows (local:session-prefill fresh '(2 1)))))
          (local:close-session fresh))))))

(test q8-cache-groups-rounding-and-overwrite
  (let* ((values (append '(127f0 -127f0 0.5f0 1.5f0 2.5f0 -0.5f0 -1.5f0)
                         (make-list 25 :initial-element 0f0) '(0f0 0f0 0f0)))
         (rows (ct:reshape (ct:from-data values) '(1 1 35)))
         (cache (local:make-kv-cache 3 :cache-type :q8)))
    (multiple-value-bind (keys vals) (local:kv-cache-update cache 0 rows rows 0)
      (is (rows-close-p (tensor-rows (ct:reshape keys '(1 35)))
                        (list (append '(127f0 -127f0 0f0 2f0 2f0 0f0 -2f0)
                                      (make-list 28 :initial-element 0f0)))))
      (is (equalp (ct:tensor-shape keys) (ct:tensor-shape vals))))
    (let* ((buffers (gethash 0 (local::kv-cache-layers cache)))
           (keys (car buffers)))
      (is (= 105 (length (local::q8-buffer-bytes keys))))
      (is (= 6 (length (local::q8-buffer-scales keys))))
      (is (= 1f0 (aref (local::q8-buffer-scales keys) 1))))
    (local:kv-cache-update cache 0 rows rows 1)
    (multiple-value-bind (keys vals)
        (local:kv-cache-update cache 0 (ct:zeros '(1 1 35)) (ct:zeros '(1 1 35)) 0)
      (declare (ignore vals))
      (is (= 1 (aref (ct:tensor-shape keys) 0)))
      (is (every #'zerop (first (tensor-rows (ct:reshape keys '(1 35)))))))
    (signals local:context-overflow (local:kv-cache-update cache 0 rows rows 3))))

(test q8-cache-rejects-nonfinite-values-and-invalid-options
  (with-session (session model) ()
    (is (eq :f32 (local:session-cache-type session)))
    (signals local:session-error (local:make-session model :cache-type :q4)))
  (dolist (name '(float-features:single-float-positive-infinity float-features:single-float-nan))
    (let ((row (ct:reshape (ct:from-data (list (symbol-value name))) '(1 1 1))))
      (signals local:session-error
        (local:kv-cache-update (local:make-kv-cache 4 :cache-type :q8) 0 row row 0)))))

(test q8-cached-models-match-fresh-quantized-runs
  (dolist (arch '("blk-llama" "blk-qwen"))
    (let* ((spec (spec* :head-dim 8 :rope-dims 8 :dim 16 :heads 2 :kv 1
                        :qk-norm (equal arch "blk-qwen")))
           (table (weight-table spec)))
      (with-spec-model (model arch spec table)
        (let ((a (local:make-session model :cache-type :q8 :n-batch 2))
              (b (local:make-session model :cache-type :q8 :n-batch 512)))
          (unwind-protect
               (progn
                 (is (rows-close-p (tensor-rows (local:session-prefill a '(3 0 5 2)))
                                   (tensor-rows (local:session-prefill b '(3 0 5 2)))))
                 (is (equal (nth-value 2 (local:generate a '(6) :max-tokens 3))
                            (nth-value 2 (local:generate b '(6) :max-tokens 3)))))
            (local:close-session a) (local:close-session b)))))))

(test q8-cache-encodes-strided-rows
  (let* ((source (ct:reshape (ct:arange 210) '(2 3 35)))
         (rows (ct:transpose source :axes '(1 0 2)))
         (strided (local::make-q8-buffer '(3 2 35)))
         (copied (local::make-q8-buffer '(3 2 35))))
    (local::store-q8-rows strided rows 0)
    (local::store-q8-rows copied (ct:copy-tensor rows) 0)
    (is (equalp (local::q8-buffer-bytes strided) (local::q8-buffer-bytes copied)))
    (is (equalp (local::q8-buffer-scales strided) (local::q8-buffer-scales copied)))))

(test q8-cache-reconstructs-finite-extrema
  (let* ((rows (ct:reshape (ct:from-data (list most-positive-single-float (- most-positive-single-float))) '(1 1 2)))
         (cache (local:make-kv-cache 1 :cache-type :q8)))
    (multiple-value-bind (keys values) (local:kv-cache-update cache 0 rows rows 0)
      (declare (ignore values))
      (is (= most-positive-single-float (ct:tref keys 0 0 0)))
      (is (= (- most-positive-single-float) (ct:tref keys 0 0 1))))))

(defun read-cache-oracle (name)
  (let* ((root (asdf:system-source-directory "cl-inference"))
         (manifest (st::read-json-file (merge-pathnames "tools/kv-cache-reference-manifest.json" root)))
         (entry (gethash name manifest))
         (path (merge-pathnames (format nil "reference/~A-kv-q8.json" name) root)))
    (unless entry (error "No pinned cache reference for ~A" name))
    (unless (probe-file path)
      (when (equal "1" (uiop:getenv "CL_INFERENCE_CACHE_ACCEPTANCE_STRICT"))
        (error "Missing ~A; cache acceptance is not established" path))
      (return-from read-cache-oracle nil))
    (flet ((verify (file expected)
             (unless (uiop:subpathp (truename file) (truename root))
               (error "Cache reference input escapes repository: ~A" file))
             (unless (equal expected (subseq (uiop:run-program
                                              (list "shasum" "-a" "256" (namestring file)) :output :string) 0 64))
               (error "Cache reference SHA256 differs: ~A" file))))
      (verify path (gethash "sha256" entry))
      (let ((oracle (st::read-json-file path)))
        (unless (equalp (gethash "metadata" entry) (gethash "metadata" oracle))
          (error "Cache reference provenance differs: ~A" name))
        (maphash (lambda (relative hash) (verify (merge-pathnames relative root) hash))
                 (gethash "inputs" (gethash "metadata" oracle)))
        oracle))))

(defun cache-logit-errors (actual expected)
  (let ((squared 0d0) (norm 0d0) (actual-norm 0d0) (dot 0d0) (maximum 0d0))
    (unless (= (length actual) (length expected)) (error "Cache logit dimensions differ"))
    (loop for a across actual for e across expected
          do (unless (local::finite-kv-p a) (error "Non-finite cache logit"))
             (let ((a (coerce a 'double-float)) (e (coerce e 'double-float)))
               (incf squared (expt (- a e) 2))
               (incf norm (* e e)) (incf actual-norm (* a a)) (incf dot (* a e))
               (setf maximum (max maximum (abs (- a e))))))
    (values maximum (sqrt (/ squared (max norm least-positive-normalized-double-float)))
            (/ dot (max (sqrt (* norm actual-norm)) least-positive-normalized-double-float)))))

(defun check-q8-cache-oracle (name model oracle)
  (let ((q8 (local:make-session model :cache-type :q8 :n-ctx 256 :n-batch 7))
        (f32 (local:make-session model :n-ctx 256 :n-batch 7))
        (tokens (gethash "ids" oracle)) (greedy (gethash "greedy" oracle)) (initial-full nil))
    (unwind-protect
         (progn
           (loop for expected across (gethash "logits" oracle) for step from 0
                 for input = (if (zerop step) tokens (vector (aref greedy (1- step))))
                 for actual = (local:session-prefill q8 input)
                 for full = (local:session-prefill f32 input)
                 do (when (zerop step) (setf initial-full (local::logits-vector full)))
                    (multiple-value-bind (maximum relative)
                        (cache-logit-errors (local::logits-vector actual) expected)
                      (format t "~&~A step ~D oracle: max ~,6F L2 ~,6F~%" name step maximum relative)
                      (is (< maximum 1d0)) (is (< relative 0.05d0)))
                    (multiple-value-bind (maximum relative cosine)
                        (cache-logit-errors (local::logits-vector actual) (local::logits-vector full))
                      (declare (ignore maximum))
                      (format t "~&~A step ~D F32: L2 ~,6F cosine ~,8F~%" name step relative cosine)
                      (is (<= relative 0.15d0)) (is (>= cosine 0.99d0)))
                    (when (< step (length greedy))
                      (is (= (aref greedy step) (local:greedy-sampler actual)))))
           (is (< (local::cache-storage-bytes (local::session-cache q8))
                  (* 0.3 (local::cache-storage-bytes (local::session-cache f32)))))
           (let ((replayed nil))
             (local:generate f32 tokens :prompt-p t :stop-ids '(0) :timeout 3600000
                             :sampler (lambda (logits) (setf replayed (local::logits-vector logits)) 0))
             (multiple-value-bind (maximum relative) (cache-logit-errors replayed initial-full)
               (is (< maximum 0.005d0)) (is (< relative 0.0001d0))))
           (let ((extended (local:session-prefill f32 #(42))))
             (local:session-reset f32)
             (multiple-value-bind (maximum relative)
                 (cache-logit-errors (local::logits-vector extended)
                                     (local::logits-vector
                                      (local:session-prefill f32 (concatenate 'vector tokens #(42)))))
               (is (< maximum 0.005d0)) (is (< relative 0.0001d0))))
           (multiple-value-bind (text finish ids usage)
               (local:generate q8 tokens :prompt-p t :stop-ids nil :max-tokens 8 :timeout 3600000)
             (declare (ignore text))
             (is (eq :length finish))
             (is (equalp greedy (coerce ids 'vector)))
             (is (= (1- (length tokens)) (getf usage :cached-prompt-tokens)))))
      (local:close-session q8) (local:close-session f32))))
