(in-package #:cl-inference/local/tests)
(in-suite :cl-inference/local)

(defun hf-spm-data (name)
  (asdf:system-relative-pathname "cl-inference" (format nil "tests/local/data/hf-sentencepiece-~A.json" name)))

(defun hf-spm-fixture ()
  (cl-inference/hf:read-json-file (hf-spm-data "tokenizer")))

(defun hf-spm-config ()
  (alexandria:plist-hash-table
   '("bos_token" "<s>" "eos_token" "</s>" "unk_token" "<unk>"
     "pad_token" "</s>" "clean_up_tokenization_spaces" nil) :test 'equal))

(defun write-hf-spm-fixture (directory &optional (object (hf-spm-fixture)) (config (hf-spm-config)))
  (write-hf-model directory "llama" (spec*) (weight-table (spec*)))
  (write-hf-json directory "tokenizer.json" object)
  (write-hf-json directory "tokenizer_config.json" config))

(defun check-hf-spm-cases (tokenizer cases)
  (loop for entry across (gethash "cases" cases)
        for ids = (gethash "ids" entry)
        do (when (nth-value 1 (gethash "text" entry))
             (is (equalp ids (local:encode tokenizer (gethash "text" entry)
                                          :special (gethash "special" entry) :add-bos (gethash "bos" entry)))))
           (dolist (special '(nil t))
             (let* ((expected (gethash (if special "rendered" "decoded") entry))
                    (decoder (local:make-detokenizer tokenizer :special special))
                    (streamed (with-output-to-string (out)
                                (loop for id across ids do (write-string (local:detokenizer-push decoder id) out))
                                (write-string (local:detokenizer-finish decoder) out))))
               (is (equal expected (local:decode tokenizer ids :special special)))
               (is (equal expected streamed))
               (is (equal "" (local:detokenizer-finish decoder)))))))

(test hf-sentencepiece-offline-pipeline-parity-and-lifetime
  (with-hf-directory (directory)
    (write-hf-spm-fixture directory)
    (let ((tokenizer (local:with-weights (weights directory) (local:load-tokenizer weights))))
      (check-hf-spm-cases tokenizer (cl-inference/hf:read-json-file (hf-spm-data "expected")))
      (is (equalp #(1) (local:encode tokenizer "")))
      (is (equalp #() (local:encode tokenizer "" :add-bos nil)))
      (is (not (local:tokenizer-ignore-merges-p tokenizer)))
      (is (equalp #(32) (local:token-bytes tokenizer (local:token-id tokenizer "▁"))))
      (signals local:tokenizer-error (local:pre-tokenize tokenizer "hello"))
      (signals local:tokenizer-error (local:decode tokenizer #(-1)))
      (signals local:tokenizer-error (local:detokenizer-push (local:make-detokenizer tokenizer) 100000)))))

(test hf-sentencepiece-real-artifact-parity
  (let ((reference (asdf:system-relative-pathname "cl-inference" "reference/hf-sentencepiece/")))
    (if (and (probe-file (merge-pathnames "tokenizer.json" reference))
             (probe-file (merge-pathnames "tokenizer_config.json" reference)))
        (with-hf-directory (directory)
          (write-hf-model directory "llama" (spec*) (weight-table (spec*)))
          (dolist (name '("tokenizer.json" "tokenizer_config.json"))
            (uiop:copy-file (merge-pathnames name reference) (merge-pathnames name directory)))
          (local:with-weights (weights directory)
            (let ((tokenizer (local:load-tokenizer weights)))
              (check-hf-spm-cases tokenizer (cl-inference/hf:read-json-file (hf-spm-data "real-expected")))
              (signals local:chat-template-error (local:load-chat-template weights)))))
        (if (uiop:getenv "CL_INFERENCE_HF_SENTENCEPIECE_STRICT")
            (fail "Pinned TinyLlama tokenizer artifacts are required")
            (skip "Pinned TinyLlama tokenizer artifacts are absent")))))

(defun hf-spm-set-path (object path value)
  (let ((parent (reduce (lambda (item key) (if (integerp key) (aref item key) (gethash key item)))
                        (butlast path) :initial-value object))
        (key (car (last path))))
    (if (integerp key) (setf (aref parent key) value) (setf (gethash key parent) value)))
  object)

(test hf-sentencepiece-rejects-pipeline-variants
  (with-hf-directory (directory)
    (dolist (change '((("model" "type") "Unigram")
                      (("model" "byte_fallback") nil)
                      (("model" "dropout") 0.1)
                      (("model" "unk_token") "missing")
                      (("model" "fuse_unk") nil)
                      (("model" "ignore_merges") t)
                      (("model" "continuing_subword_prefix") "x")
                      (("model" "end_of_word_suffix") "x")
                      (("model" "merges") #("missing a"))
                      (("model" "merges") #("a  b"))
                      (("model" "vocab" "<0x00>") 10000001)
                      (("model" "vocab" "<0x00>") 1)
                      (("model" "vocab" "") 1000)
                      (("added_tokens" 0 "content") "missing")
                      (("added_tokens" 0 "normalized") t)
                      (("added_tokens" 0 "single_word") t)
                      (("added_tokens" 0 "lstrip") t)
                      (("added_tokens" 0 "rstrip") t)
                      (("added_tokens" 0 "special") nil)
                      (("normalizer" "normalizers" 0 "prepend") " ")
                      (("normalizer" "normalizers" 1 "pattern" "String") "x")
                      (("normalizer" "normalizers" 1 "content") "x")
                      (("pre_tokenizer") :unsupported)
                      (("decoder" "decoders" 0 "content") "x")
                      (("decoder" "decoders" 1 "type") "ByteLevel")
                      (("decoder" "decoders" 2 "type") "ByteLevel")
                      (("decoder" "decoders" 3 "start") 2)
                      (("decoder" "decoders" 3 "stop") 1)
                      (("post_processor" "special_tokens" "<s>" "ids") #(2))
                      (("post_processor" "single" 0 "SpecialToken" "id") "</s>")
                      (("padding") t)
                      (("truncation") t)))
      (write-hf-spm-fixture directory (hf-spm-set-path (hf-spm-fixture) (first change) (second change)))
      (local:with-weights (weights directory)
        (signals local:tokenizer-error (local:load-tokenizer weights))))
    (let ((object (hf-spm-fixture)))
      (remhash "<0xFF>" (gethash "vocab" (gethash "model" object)))
      (write-hf-spm-fixture directory object)
      (local:with-weights (weights directory)
        (signals local:tokenizer-error (local:load-tokenizer weights))))))

(test hf-sentencepiece-configuration-and-bos
  (with-hf-directory (directory)
    (dolist (entry '(("bos_token" . "</s>") ("eos_token" . "<s>") ("unk_token" . "</s>")
                     ("add_eos_token" . t) ("add_prefix_space" . t) ("split_special_tokens" . t)
                     ("add_bos_token" . "true")
                     ("clean_up_tokenization_spaces" . t)
                     ("clean_up_tokenization_spaces_for_bpe_even_though_it_will_corrupt_output" . t)))
      (let ((config (hf-spm-config)))
        (setf (gethash (car entry) config) (cdr entry))
        (write-hf-spm-fixture directory (hf-spm-fixture) config)
        (local:with-weights (weights directory)
          (signals local:tokenizer-error (local:load-tokenizer weights)))))
    (let ((config (hf-spm-config)))
      (setf (gethash "add_bos_token" config) nil)
      (write-hf-spm-fixture directory (hf-spm-fixture) config)
      (local:with-weights (weights directory)
        (let ((tokenizer (local:load-tokenizer weights)))
          (is (equalp #() (local:encode tokenizer "")))
          (is (equalp #(1) (local:encode tokenizer "" :add-bos t))))))))

(test hf-sentencepiece-chat-provenance-and-stream-buffering
  (local:define-chat-template hf-spm-provenance-chat ()
    (:message "<s>~a:~a</s>"))
  (with-hf-directory (directory)
    (write-hf-spm-fixture directory)
    (local:with-weights (weights directory)
      (let* ((tokenizer (local:load-tokenizer weights))
             (payload "<s>hello</s><unk>")
             (ids (local:encode-chat (make-instance 'hf-spm-provenance-chat) tokenizer
                                     (list (list :role :user :content payload)) :add-generation-prompt nil))
             (decoder (local:make-detokenizer tokenizer)))
        (is (= 2 (count 1 ids)))
        (is (= 1 (count 2 ids)))
        (is (not (find 0 ids)))
        (is (search payload (local:decode tokenizer ids)))
        (is (equal "" (local:detokenizer-push decoder (local:token-id tokenizer "<0x61>"))))
        (is (equal "" (local:detokenizer-push decoder (local:token-id tokenizer "<0xFF>"))))
        (is (equal "��" (local:detokenizer-finish decoder)))))))
