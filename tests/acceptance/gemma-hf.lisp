(in-package #:cl-inference/acceptance)
(def-suite :cl-inference/gemma-hf/acceptance :in :cl-inference/acceptance)
(in-suite :cl-inference/gemma-hf/acceptance)

(defun gemma-hf-oracle ()
  (let* ((root (tests::verify-gemma-hf-reference
                :inference t :strict (equal "1" (uiop:getenv "CL_INFERENCE_GEMMA_HF_STRICT"))))
         (manifest (com.inuoe.jzon:parse
                    (asdf:system-relative-pathname "cl-inference" "tools/gemma-hf-manifest.json"))))
    (when root
      (let ((data (com.inuoe.jzon:parse (merge-pathnames "oracle.json" root))))
        (unless (and (equal "float32" (gethash "precision" data))
                     (equalp (gethash "packages" data) (gethash "packages" manifest)))
          (error "Gemma HF oracle provenance differs"))
        data))))

(defun gemma-hf-read-logits (name rows)
  (with-open-file (stream (reference-path "gemma-hf" (format nil "~A.f32" name))
                          :element-type '(unsigned-byte 8))
    (unless (= (file-length stream) (* rows 262144 4)) (error "Malformed Gemma HF logit dump"))
    (loop repeat rows collect
      (let ((bytes (make-array (* 262144 4) :element-type '(unsigned-byte 8)))
            (values (make-array 262144 :element-type 'single-float)))
        (read-sequence bytes stream)
        (cffi:with-pointer-to-vector-data (pointer bytes)
          (dotimes (i 262144) (setf (aref values i) (cffi:mem-aref pointer :float i))))
        values))))

(defun gemma-cpu-traced-prefill (model tokens)
  (let* ((logits nil)
         (layers (tests::tracing-layers (setf logits (local:model-forward model tokens)))))
    (values (local::logits-vector logits)
            (mapcar (lambda (layer) (vector-of-row layer (1- (length tokens)))) layers))))

(defun gemma-check-values (actual expected &key top)
  (let ((actual (map 'vector (lambda (x) (coerce x 'double-float)) actual))
        (expected (map 'vector (lambda (x) (coerce x 'double-float)) expected)))
    (is (every (lambda (v) (not (or (float-features:float-nan-p v)
                                   (float-features:float-infinity-p v)))) actual))
    (is (>= (cosine actual expected) 0.9999d0))
    (is (<= (relative-error actual expected) 0.02d0))
    (when top (is (equal (top-ids actual 5) (top-ids expected 5))))))

(defun compare-gemma-hf (name data loader tracer backend-maker backend-closer)
  (let* ((entry (gethash name (gethash "cases" data)))
         (case (gethash name (gethash "cases" *gemma-manifest*)))
         (messages (when (gethash "messages" case)
                     (loop for message across (gethash "messages" case)
                           collect (list :role (intern (string-upcase (gethash "role" message)) :keyword)
                                         :content (gethash "content" message)))))
         (expected (gemma-hf-read-logits name (gethash "rows" entry))))
    (local:with-weights (weights (reference-path "gemma-hf" "model"))
      (let* ((model (funcall loader weights)) (session nil))
        (unwind-protect
             (let* ((tokenizer (local:load-tokenizer weights)) (template (local:load-chat-template weights))
                    (ids (if messages (local:encode-chat template tokenizer messages)
                             (local:encode tokenizer (gethash "prompt" entry))))
                    (stops (local:chat-template-stop-ids template tokenizer))
                    (greedy (coerce (gethash "greedy" entry) 'list)))
               (is (equalp ids (gethash "ids" entry)))
               (multiple-value-bind (logits layers) (funcall tracer model ids)
                 (gemma-check-values logits (first expected) :top t)
                 (is (= 18 (length layers)))
                 (loop for layer in layers for reference across (gethash "layers" entry)
                       do (gemma-check-values layer reference)))
               (setf session (local:make-session model :tokenizer tokenizer :chat-template template
                                                 :n-ctx 1024 :n-batch 128))
               (let ((logits (local:session-prefill session ids)))
                 (gemma-check-values (local::logits-vector logits) (first expected) :top t)
                 (loop for token in greedy for step from 1
                       do (is (= token (local:greedy-sampler logits)))
                          (when (< step (length expected))
                            (setf logits (local:session-prefill session (list token)))
                            (gemma-check-values (local::logits-vector logits) (nth step expected)))))
               (local:session-reset session)
               (let* ((stop (position-if (lambda (id) (member id stops)) greedy))
                      (wanted (subseq greedy 0 stop)) (finish (if stop :stop :length)))
                 (multiple-value-bind (text actual-finish actual-ids)
                     (local:generate session ids :max-tokens 8 :timeout 3600000)
                   (declare (ignore text))
                   (is (equal wanted actual-ids))
                   (is (eq finish actual-finish)))
                 (when messages
                   (let ((backend (funcall backend-maker weights :n-ctx 1024 :n-batch 128)))
                     (unwind-protect
                          (let* ((events nil)
                                 (reply (ci:complete backend :messages messages :max-tokens 8 :temperature 0
                                                     :timeout 3600000 :stream (lambda (event) (push event events)))))
                            (is (not (ci:result-error-p reply)))
                            (let ((result (second reply)))
                              (is (string= (local:decode tokenizer wanted) (ci:content-text (getf result :content))))
                              (is (eq finish (getf (getf result :meta) :finish-reason)))
                              (is (string= (ci:content-text (getf result :content)) (tests::event-text (reverse events))))))
                       (funcall backend-closer backend))))))
          (when session (local:close-session session))
          (local:close-model model))))))

(test gemma-hf-cpu-real-model
  (let ((data (gemma-hf-oracle)))
    (if data
        (dolist (name '("plain" "chat" "system" "multi" "window"))
          (format t "~&Gemma HF CPU: ~A~%" name)
          (compare-gemma-hf name data #'local:load-model #'gemma-cpu-traced-prefill
                            #'local:make-local-backend #'local:close-local-backend))
        (skip "Pinned Gemma HF references are absent"))))
