(in-package #:cl-inference/safetensors)

(define-condition safetensors-error (local:weights-error) ())

(defun fail (control &rest args)
  (apply #'local:weights-fail 'safetensors-error control args))

(defconstant +maximum-json-bytes+ 100000000)

(defun read-json-value (parser event value depth)
  (when (> depth 128) (fail "JSON nesting exceeds 128 levels"))
  (case event
    (:value (values value nil))
    (:begin-object
     (let ((object (make-hash-table :test 'equal)) (keys nil))
       (loop
         (multiple-value-bind (event key) (json:parse-next parser)
           (when (eq event :end-object) (return (values object (nreverse keys))))
           (unless (eq event :object-key) (fail "Expected a JSON object key"))
           (when (nth-value 1 (gethash key object)) (fail "Duplicate JSON key ~S" key))
           (multiple-value-bind (event value) (json:parse-next parser)
             (setf (gethash key object) (read-json-value parser event value (1+ depth))))
           (push key keys)))))
    (:begin-array
     (let ((items nil))
       (loop
         (multiple-value-bind (event value) (json:parse-next parser)
           (when (eq event :end-array) (return (coerce (nreverse items) 'vector)))
           (push (read-json-value parser event value (1+ depth)) items)))))
    (t (fail "Incomplete JSON value"))))

(defun parse-json-object (octets)
  (let ((text (babel:octets-to-string octets :encoding :utf-8 :errorp t)))
    (json:with-parser (parser text :key-fn nil :max-string-length +maximum-json-bytes+)
      (multiple-value-bind (event value) (json:parse-next parser)
        (unless (eq event :begin-object) (fail "Expected a JSON object"))
        (multiple-value-bind (object keys) (read-json-value parser event value 0)
          (when (json:parse-next parser) (fail "Trailing JSON content"))
          (values object keys))))))

(defun read-json-file (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((size (file-length stream)))
      (when (> size +maximum-json-bytes+) (fail "JSON file ~A exceeds 100 MB" path))
      (let ((octets (make-array size :element-type '(unsigned-byte 8))))
        (unless (= size (read-sequence octets stream)) (fail "Truncated JSON file ~A" path))
        (parse-json-object octets)))))

(defparameter *types*
  '(("F32" :f32 4 :f32 :f32) ("F64" :f64 8 :f64 :f64)
    ("F16" :f16 2 :u16 :f16) ("BF16" :bf16 2 :u16 :bf16)
    ("I8" :i8 1 :s8 :s8) ("U8" :u8 1 :u8 :u8)
    ("I16" :i16 2 :s16 :s16) ("U16" :u16 2 :u16 :u16)
    ("I32" :i32 4 :s32 :s32) ("U32" :u32 4 :u32 :u32)
    ("I64" :i64 8 :s64 :s64) ("U64" :u64 8 :u64 :u64)
    ("BOOL" :bool 1 nil nil) ("F8_E4M3" :f8_e4m3 1 nil nil)
    ("F8_E5M2" :f8_e5m2 1 nil nil) ("F8_E8M0" :f8_e8m0 1 nil nil)))

(defstruct (safetensors-tensor (:include local:tensor-info))
  (offset 0 :type (integer 0))
  pointer)

(defstruct shard path pointer size tensors metadata)

(defun header-length (pointer)
  (loop for i below 8 sum (ash (cffi:mem-aref pointer :uint8 i) (* 8 i))))

(defun parse-tensor (name entry pointer data-start data-size)
  (unless (hash-table-p entry) (fail "Tensor ~S must be an object" name))
  (let* ((type (assoc (gethash "dtype" entry) *types* :test #'equal))
         (shape (gethash "shape" entry))
         (offsets (gethash "data_offsets" entry)))
    (unless type (fail "Unknown or unsupported encoding for tensor ~S: ~S"
                       name (gethash "dtype" entry)))
    (unless (and (vectorp shape) (not (stringp shape))
                 (every (lambda (dim) (typep dim '(integer 0 #.most-positive-fixnum))) shape))
      (fail "Invalid shape for tensor ~S" name))
    (unless (and (vectorp offsets) (= (length offsets) 2)
                 (every (lambda (offset) (typep offset '(integer 0))) offsets)
                 (<= (aref offsets 0) (aref offsets 1) data-size))
      (fail "Invalid offsets for tensor ~S" name))
    (let* ((count (reduce #'* shape))
           (bytes (* count (third type)))
           (begin (aref offsets 0)) (end (aref offsets 1)))
      (unless (and (<= count most-positive-fixnum) (= bytes (- end begin)))
        (fail "Payload size does not match shape and dtype for tensor ~S" name))
      (make-safetensors-tensor :name name :shape (coerce shape 'list)
                              :format-type (second type) :byte-count bytes :offset begin
                              :pointer (cffi:inc-pointer pointer (+ data-start begin))))))

(defun parse-shard (path pointer size)
  (let ((length (header-length pointer)))
    (unless (and (<= 2 length +maximum-json-bytes+) (<= (+ 8 length) size)
                 (= (cffi:mem-aref pointer :uint8 8) #x7b))
      (fail "Invalid Safetensors header length or prefix in ~A" path))
    (let ((octets (make-array length :element-type '(unsigned-byte 8)))
          (start (+ 8 length)) (tensors nil))
      (dotimes (i length) (setf (aref octets i) (cffi:mem-aref pointer :uint8 (+ 8 i))))
      (multiple-value-bind (header keys) (parse-json-object octets)
        (let ((metadata (gethash "__metadata__" header)))
          (when (nth-value 1 (gethash "__metadata__" header))
            (unless (and (hash-table-p metadata)
                         (loop for value being the hash-values of metadata always (stringp value)))
              (fail "__metadata__ must be a string-to-string object in ~A" path)))
          (dolist (name keys)
            (unless (string= name "__metadata__")
              (push (parse-tensor name (gethash name header) pointer start (- size start)) tensors)))
          (let ((cursor 0))
            (dolist (info (stable-sort (copy-list tensors)
                                      (lambda (a b)
                                        (or (< (safetensors-tensor-offset a) (safetensors-tensor-offset b))
                                            (and (= (safetensors-tensor-offset a) (safetensors-tensor-offset b))
                                                 (< (local:tensor-info-byte-count a)
                                                    (local:tensor-info-byte-count b)))))))
              (unless (= cursor (safetensors-tensor-offset info))
                (fail "Tensor ~S overlaps data or leaves a gap in ~A"
                      (local:tensor-info-name info) path))
              (incf cursor (local:tensor-info-byte-count info)))
            (unless (= cursor (- size start)) (fail "Unindexed payload bytes in ~A" path)))
          (make-shard :path path :pointer pointer :size size :metadata metadata
                      :tensors (nreverse tensors)))))))

(defun open-shard (path)
  (multiple-value-bind (pointer size) (mapping:map-file path 10 #'fail)
    (let ((success nil))
      (unwind-protect
           (prog1 (parse-shard path pointer size) (setf success t))
        (unless success (mapping:unmap-file pointer size #'fail))))))

(defun release-shards (shards)
  (let ((problem nil))
    (dolist (shard shards)
      (handler-case (mapping:unmap-file (shard-pointer shard) (shard-size shard) #'fail)
        (error (e) (unless problem (setf problem e)))))
    (when problem (error problem))))
