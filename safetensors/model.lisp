(in-package #:cl-inference/safetensors)

(defmethod local::normalize-hparam-value ((weights safetensors-weights) value)
  (cond ((eq value 'cl:null) nil)
        ((and (equal "gemma3_text" (local:weights-architecture-name weights))
              (vectorp value) (not (stringp value)))
         (map 'vector (lambda (entry)
                        (cond ((equal entry "sliding_attention") t)
                              ((equal entry "full_attention") nil)
                              (t entry))) value))
        (t value)))

(defun configured-p (weights key)
  (let ((value (local:weights-metadata weights key)))
    (and value (not (eq value 'cl:null)))))

(defun validate-hf-model (weights architecture &key quantized)
  (let ((gemma (typep architecture 'local:gemma3)))
    (flet ((reject (control &rest args)
             (apply #'local::architecture-fail 'local:architecture-error control args)))
      (dolist (key (append '("quantization" "quantization_config" "attention_bias" "mlp_bias"
                              "use_sliding_window" "rope_parameters")
                           (unless gemma '("sliding_window"))))
        (when (and (configured-p weights key)
                   (not (and quantized (not gemma) (member key '("quantization" "quantization_config") :test #'equal))))
          (reject "HF model loading does not support ~A" key)))
      (multiple-value-bind (activation present) (local:weights-metadata weights "hidden_act")
        (when (and present (not (equal activation "silu")))
          (reject "HF model loading requires hidden_act=silu")))
      (multiple-value-bind (partial present) (local:weights-metadata weights "partial_rotary_factor")
        (when (and present (not (and (realp partial) (= partial 1))))
          (reject "HF model loading requires full rotary dimensions")))
      (when gemma
        (unless (and (equal "gelu_pytorch_tanh" (local:weights-metadata weights "hidden_activation"))
                     (let ((scale (local:weights-metadata weights "query_pre_attn_scalar")))
                       (and (realp scale) (= (local:hparam architecture 'local::head-dim) scale)))
                     (every (lambda (key) (not (configured-p weights key)))
                            '("attn_logit_softcapping" "final_logit_softcapping" "use_bidirectional_attention")))
          (reject "Unsupported Gemma HF activation, attention scale or softcapping"))
        (let ((pattern (local:weights-metadata weights "_sliding_window_pattern")))
          (when pattern
            (unless (and (typep pattern '(integer 1))
                         (equalp (local:hparam architecture 'local::sliding-pattern)
                                 (map 'vector (lambda (layer) (< (mod layer pattern) (1- pattern)))
                                      (coerce (loop for layer below (local:hparam architecture 'local::n-layers)
                                                    collect layer) 'vector))))
              (reject "Inconsistent Gemma layer_types and sliding pattern")))))
      (dolist (name '(local::n-layers local::dim local::n-heads local::n-kv-heads))
        (unless (typep (local:hparam architecture name) '(integer 1))
          (reject "HF hparam ~A must be a positive integer" name)))
      (let* ((heads (local:hparam architecture 'local::n-heads))
             (kv (local:hparam architecture 'local::n-kv-heads))
             (dim (local:hparam architecture 'local::dim))
             (explicit (local:hparam architecture 'local::head-dim))
             (head-dim (or explicit (floor dim heads)))
             (theta (local:hparam architecture 'local::rope-theta))
             (epsilon (local:hparam architecture 'local::rms-epsilon))
             (context (local:hparam architecture 'local::context-length)))
        (unless (and (zerop (mod heads kv)) (or explicit (zerop (mod dim heads)))
                     (typep head-dim '(integer 1)) (evenp head-dim)
                     (realp theta) (plusp theta) (realp epsilon) (plusp epsilon)
                     (or (null context) (typep context '(integer 1))))
          (reject "Invalid HF attention dimensions, RoPE base, epsilon or context length")))
      (unless (or (local:weights-tensor-info-ref weights "lm_head.weight")
                  (eq t (local:weights-metadata weights "tie_word_embeddings"))
                  (and gemma (not (nth-value 1 (local:weights-metadata weights "tie_word_embeddings")))))
        (reject "Missing lm_head.weight without tie_word_embeddings=true"))
      (dolist (info (local:weights-tensor-info-list weights))
        (let ((name (local:tensor-info-name info)))
          (when (and (>= (length name) 5) (string= ".bias" name :start2 (- (length name) 5)))
            (reject "HF model loading does not support bias tensor ~A" name))
          (unless (member (local:tensor-info-format-type info) (if quantized '(:f32 :f16 :bf16 :u32) '(:f32 :f16 :bf16)))
            (reject "Unsupported HF tensor type for ~A: ~A"
                    name (local:tensor-info-format-type info))))))))

(defmethod local::validate-model-weights ((weights safetensors-weights) (architecture local:llama))
  (validate-hf-model weights architecture))
