(in-package #:cl-inference/safetensors)

(defparameter *qwen-pattern* "(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\\r\\n\\p{L}\\p{N}]?\\p{L}+|\\p{N}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")
(defparameter *llama-pattern* "(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\\r\\n\\p{L}\\p{N}]?\\p{L}+|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")

(defmethod local::tokenizer-class-for-weights ((format (eql :safetensors)) weights model pre)
  (declare (ignore weights model))
  (find-class (cond ((equal pre "llama") 'local:llama-bpe)
                    ((equal pre "qwen3") 'local:qwen2)
                    (t (local::tokenizer-fail 'local:tokenizer-error "Unsupported HF tokenizer ~S" pre)))))

(defmethod local::normalize-tokenizer-text ((tokenizer local:qwen2) text)
  (if (and (eq (local:tokenizer-format tokenizer) :safetensors)
           (plusp (length text)))
      (map 'string #'code-char (cl-unicode:normalization-form-c text))
      text))

(defun hf-sidecar (weights filename &optional required)
  (let ((path (merge-pathnames filename (uiop:pathname-directory-pathname (local:weights-path weights)))))
    (cond ((probe-file path) (read-json-file path))
          (required (local::tokenizer-fail 'local:tokenizer-error "Missing HF file ~A" path)))))

(defun hf-null-p (value) (or (null value) (eq value 'cl:null)))

(defun hf-bos-postprocessor (post)
  (when (or (hf-null-p post) (equal "ByteLevel" (gethash "type" post)))
    (return-from hf-bos-postprocessor nil))
  (when (equal "Sequence" (gethash "type" post))
    (let ((parts (gethash "processors" post)))
      (unless (and (vectorp parts) (= (length parts) 2)
                   (hash-table-p (aref parts 0)) (equal "ByteLevel" (gethash "type" (aref parts 0))))
        (local::tokenizer-fail 'local:tokenizer-error "Unsupported HF postprocessor sequence"))
      (setf post (aref parts 1))))
  (let* ((single (gethash "single" post))
         (special (and (vectorp single) (= (length single) 2)
                       (gethash "SpecialToken" (aref single 0))))
         (sequence (and special (gethash "Sequence" (aref single 1))))
         (token (and (hash-table-p special) (gethash "id" special)))
         (table (gethash "special_tokens" post))
         (entry (and (hash-table-p table) token (gethash token table)))
         (ids (and (hash-table-p entry) (gethash "ids" entry))))
    (unless (and (equal "TemplateProcessing" (gethash "type" post))
                 (hash-table-p sequence) (equal "A" (gethash "id" sequence))
                 (stringp token) (vectorp ids) (= (length ids) 1) (integerp (aref ids 0)))
      (local::tokenizer-fail 'local:tokenizer-error "HF postprocessor must add only one BOS token"))
    (values token (aref ids 0))))

(defun check-hf-pipeline (object architecture)
  (flet ((reject () (local::tokenizer-fail 'local:tokenizer-error "Unsupported HF tokenizer pipeline for ~A" architecture)))
    (let* ((model (gethash "model" object)) (normalizer (gethash "normalizer" object))
           (pre (gethash "pre_tokenizer" object))
           (parts (and (hash-table-p pre) (gethash "pretokenizers" pre)))
           (split (and (vectorp parts) (= (length parts) 2) (aref parts 0)))
           (byte (and split (aref parts 1)))
           (pattern (and (hash-table-p split) (gethash "pattern" split)))
           (post (gethash "post_processor" object)) (decoder (gethash "decoder" object)))
      (unless (and (hf-null-p (gethash "padding" object)) (hf-null-p (gethash "truncation" object))
                   (hash-table-p model) (equal "BPE" (gethash "type" model))
                   (hf-null-p (gethash "dropout" model))
                   (hf-null-p (gethash "unk_token" model))
                   (member (gethash "continuing_subword_prefix" model) '(nil cl:null "") :test #'equal)
                   (member (gethash "end_of_word_suffix" model) '(nil cl:null "") :test #'equal)
                   (not (gethash "byte_fallback" model))
                   (not (gethash "fuse_unk" model))
                   (or (and (equal architecture "llama") (hf-null-p normalizer))
                       (and (equal architecture "qwen3") (hash-table-p normalizer)
                            (equal "NFC" (gethash "type" normalizer))))
                   (hash-table-p pre) (equal "Sequence" (gethash "type" pre))
                   (hash-table-p split) (equal "Split" (gethash "type" split))
                   (equal "Isolated" (gethash "behavior" split)) (not (gethash "invert" split))
                   (hash-table-p pattern)
                   (equal (if (equal architecture "llama") *llama-pattern* *qwen-pattern*)
                          (gethash "Regex" pattern))
                   (hash-table-p byte) (equal "ByteLevel" (gethash "type" byte))
                   (not (gethash "add_prefix_space" byte)) (not (gethash "use_regex" byte))
                   (hash-table-p decoder) (equal "ByteLevel" (gethash "type" decoder))
                   (or (hf-null-p post)
                       (and (hash-table-p post)
                            (or (equal "ByteLevel" (gethash "type" post))
                                (and (equal architecture "llama") (hf-bos-postprocessor post))))))
        (reject)))))

(defmethod local:tokenizer-selector ((format (eql :safetensors)) weights)
  (let* ((architecture (local:weights-architecture-name weights))
         (object (hf-sidecar weights "tokenizer.json" t)))
    (check-hf-pipeline object architecture)
    (values "BPE" architecture)))

(defun hf-vocabulary (object)
  (let* ((model (gethash "model" object)) (vocab (gethash "vocab" model))
         (added (gethash "added_tokens" object #()))
         (max-id -1))
    (unless (and (hash-table-p vocab) (vectorp added))
      (local::tokenizer-fail 'local:tokenizer-error "HF tokenizer needs a vocabulary and added_tokens array"))
    (flet ((check-id (id)
             (unless (typep id '(integer 0 10000000))
               (local::tokenizer-fail 'local:tokenizer-error "Invalid HF token id ~S" id))
             (setf max-id (max max-id id))))
      (maphash (lambda (token id) (declare (ignore token)) (check-id id)) vocab)
      (loop for token across added do (check-id (gethash "id" token))))
    (let ((tokens (make-array (1+ max-id) :initial-element nil))
          (types (make-array (1+ max-id) :element-type '(unsigned-byte 8) :initial-element local::+token-normal+)))
      (maphash (lambda (token id)
                 (when (aref tokens id) (local::tokenizer-fail 'local:tokenizer-error "Duplicate HF token id ~D" id))
                 (setf (aref tokens id) token)) vocab)
      (loop for entry across added
            for id = (gethash "id" entry) for token = (gethash "content" entry)
            do (unless (and (stringp token) (plusp (length token))
                            (or (null (aref tokens id)) (equal token (aref tokens id)))
                            (not (gethash "single_word" entry)) (not (gethash "lstrip" entry))
                            (not (gethash "rstrip" entry)) (not (gethash "normalized" entry)))
                 (local::tokenizer-fail 'local:tokenizer-error "Unsupported HF added token ~S" token))
               (setf (aref tokens id) token
                     (aref types id) (if (gethash "special" entry) local::+token-control+ local::+token-user-defined+)))
      (unless (every #'stringp tokens)
        (local::tokenizer-fail 'local:tokenizer-error "HF vocabulary has missing token ids"))
      (values tokens types))))

(defun hf-merges (object)
  (let ((merges (gethash "merges" (gethash "model" object))))
    (unless (and (vectorp merges) (not (stringp merges)))
      (local::tokenizer-fail 'local:tokenizer-error "HF BPE needs a merges array"))
    (map 'simple-vector
         (lambda (merge)
           (cond ((stringp merge) merge)
                 ((and (vectorp merge) (= (length merge) 2) (every #'stringp merge))
                  (format nil "~A ~A" (aref merge 0) (aref merge 1)))
                 (t (local::tokenizer-fail 'local:tokenizer-error "Invalid HF merge ~S" merge))))
         merges)))

(defun hf-special-ids (tokenizer weights config)
  (let (ids)
    (dolist (key '(:bos :eos :pad :unk))
      (let* ((name (string-downcase (symbol-name key)))
             (token (gethash (concatenate 'string name "_token") config))
             (content (if (hash-table-p token) (gethash "content" token) token))
             (id (unless (hf-null-p content) (local:token-id tokenizer content))))
        (when (and (not (hf-null-p content)) (null id))
          (local::tokenizer-fail 'local:tokenizer-error "Unknown HF special token ~S" content))
        (when id (setf (getf ids key) id))))
    (unless (getf ids :eos)
      (let ((id (local:weights-metadata weights "eos_token_id")))
        (when (integerp id)
          (local::check-token-id tokenizer id)
          (setf (getf ids :eos) id))))
    (setf (slot-value tokenizer 'local::special-ids) ids
          (slot-value tokenizer 'local::add-bos) (and (gethash "add_bos_token" config) t))))

(defmethod local:tokenizer-load ((tokenizer local:byte-level-bpe) (format (eql :safetensors)) weights)
  (let* ((object (hf-sidecar weights "tokenizer.json" t))
         (config (or (hf-sidecar weights "tokenizer_config.json") (make-hash-table :test 'equal))))
    ;; HF BPE decoding ignores ordinary whitespace cleanup.
    (when (or (gethash "add_prefix_space" config) (gethash "split_special_tokens" config)
              (gethash "clean_up_tokenization_spaces_for_bpe_even_though_it_will_corrupt_output" config))
      (local::tokenizer-fail 'local:tokenizer-error "Unsupported HF tokenizer configuration"))
    (multiple-value-bind (tokens types) (hf-vocabulary object)
      (setf (slot-value tokenizer 'local::tokens) tokens (slot-value tokenizer 'local::types) types)
      (local::build-vocabulary tokenizer tokens types)
      (local::build-byte-ids tokenizer)
      (local::build-merges tokenizer (hf-merges object)))
    (multiple-value-bind (bos id) (hf-bos-postprocessor (gethash "post_processor" object))
      (when bos
        (unless (eql id (local:token-id tokenizer bos))
          (local::tokenizer-fail 'local:tokenizer-error "HF postprocessor BOS id does not match vocabulary"))
        (multiple-value-bind (value present) (gethash "bos_token" config)
          (when (and present (not (equal (if (hash-table-p value) (gethash "content" value) value) bos)))
            (local::tokenizer-fail 'local:tokenizer-error "HF postprocessor and configuration disagree on BOS")))
        (setf (gethash "bos_token" config) bos)
        (unless (nth-value 1 (gethash "add_bos_token" config))
          (setf (gethash "add_bos_token" config) t))))
    (hf-special-ids tokenizer weights config)
    (setf (slot-value tokenizer 'local::ignore-merges) (and (gethash "ignore_merges" (gethash "model" object)) t))
    (local::initialize-pre-tokenizer tokenizer)
    tokenizer))

(defmethod local:chat-template-source ((format (eql :safetensors)) weights)
  (let* ((config (hf-sidecar weights "tokenizer_config.json"))
         (source (and config (gethash "chat_template" config))))
    (unless (hf-null-p source)
      (unless (and (stringp source) (local::detected-chat-template-class source))
        (local::chat-template-fail "Unsupported HF chat_template"))
      source)))

(defmethod local:tokenizer-selector :around ((format (eql :safetensors)) weights)
  (handler-case (call-next-method)
    (local:tokenizer-error (e) (error e))
    (error (e) (local::tokenizer-fail 'local:tokenizer-error "Malformed HF tokenizer: ~A" e))))

(defmethod local:tokenizer-load :around ((tokenizer local:byte-level-bpe) (format (eql :safetensors)) weights)
  (handler-case (call-next-method)
    (local:tokenizer-error (e) (error e))
    (error (e) (local::tokenizer-fail 'local:tokenizer-error "Malformed HF tokenizer: ~A" e))))
