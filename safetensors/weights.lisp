(in-package #:cl-inference/safetensors)

(defclass safetensors-weights (local:weights)
  ((shards :initarg :shards :reader weights-shards)
   (metadata :initarg :metadata :reader weights-metadata-table)
   (keys :initarg :keys :reader weights-keys)
   (tensors :initarg :tensors :reader weights-tensors)
   (tensor-table :initarg :tensor-table :reader weights-tensor-table)))

(defun index-path-p (path)
  (equal (file-namestring path) "model.safetensors.index.json"))

(defun resolve-input (path)
  (let ((directory (uiop:directory-exists-p path)))
    (if directory
        (or (probe-file (merge-pathnames "model.safetensors.index.json" directory))
            (probe-file (merge-pathnames "model.safetensors" directory))
            (fail "~A needs model.safetensors or model.safetensors.index.json" directory))
        (truename path))))

(defun resolve-shard-path (directory name)
  (unless (and (stringp name) (plusp (length name))
               (equal (pathname-type (pathname name)) "safetensors")
               (not (uiop:absolute-pathname-p name)))
    (fail "Invalid shard filename ~S" name))
  (let* ((path (truename (merge-pathnames name directory)))
         (root (namestring (truename directory))))
    (unless (and (<= (length root) (length (namestring path)))
                 (string= root (namestring path) :end2 (length root))
                 (not (uiop:directory-pathname-p path)))
      (fail "Shard ~S escapes the model directory" name))
    path))

(defun input-shards (path directory)
  (if (index-path-p path)
      (let* ((index (read-json-file path)) (map (gethash "weight_map" index)))
        (unless (and (hash-table-p map) (plusp (hash-table-count map)))
          (fail "Index ~A needs a nonempty weight_map" path))
        (let ((names (make-hash-table :test 'equal)) (resolved (make-hash-table :test 'equal)))
          (maphash (lambda (tensor name)
                     (let ((file (or (gethash name resolved)
                                     (setf (gethash name resolved) (resolve-shard-path directory name)))))
                       (setf (gethash tensor map) file
                             (gethash (namestring file) names) t)))
                   map)
          (values (mapcar #'pathname (sort (loop for name being the hash-keys of names collect name)
                                          #'string<))
                  map)))
      (values (list path) nil)))

(defun validate-index (index table)
  (when index
    (unless (= (hash-table-count index) (hash-table-count table))
      (fail "Shard tensors do not match the index"))
    (maphash (lambda (name file)
               (let ((entry (gethash name table)))
                 (unless (and entry (equal (cdr entry) file))
                   (fail "Index assigns tensor ~S to the wrong or missing shard" name))))
             index)))

(defun open-safetensors (input)
  "Open a tensor file, HF index, or model directory with optional sibling config.json."
  (handler-case
      (let* ((path (resolve-input input)) (directory (uiop:pathname-directory-pathname path))
             (config (probe-file (merge-pathnames "config.json" directory)))
             (shards nil) (success nil))
        (unwind-protect
             (multiple-value-bind (metadata keys)
                 (if config (read-json-file config) (values (make-hash-table :test 'equal) nil))
               (when (nth-value 1 (gethash "safetensors.__metadata__" metadata))
                 (fail "config.json uses reserved key safetensors.__metadata__"))
               (multiple-value-bind (paths index) (input-shards path directory)
                 (let ((table (make-hash-table :test 'equal)) (tensors nil)
                       (headers (make-hash-table :test 'equal)))
                   (dolist (file paths)
                     (let ((shard (open-shard file)))
                       (push shard shards)
                       (when (shard-metadata shard)
                         (setf (gethash (enough-namestring file directory) headers) (shard-metadata shard)))
                       (dolist (info (shard-tensors shard))
                         (let ((name (local:tensor-info-name info)))
                           (when (gethash name table) (fail "Duplicate tensor ~S across shards" name))
                           (setf (gethash name table) (cons info file))
                           (push info tensors)))))
                   (validate-index index table)
                   (setf (gethash "safetensors.__metadata__" metadata) headers)
                   (prog1 (make-instance 'safetensors-weights :format :safetensors :path path
                                        :shards (reverse shards) :metadata metadata
                                        :keys (append keys '("safetensors.__metadata__"))
                                        :tensors (nreverse tensors) :tensor-table table)
                     (setf success t)))))
          (unless success (release-shards shards))))
    (local:weights-error (e) (error e))
    (error (e) (fail "Cannot open Safetensors ~A: ~A" input e))))

(defmethod local:weights-metadata-ref ((weights safetensors-weights) key)
  (gethash key (weights-metadata-table weights)))
(defmethod local:weights-metadata-key-list ((weights safetensors-weights)) (weights-keys weights))
(defmethod local:weights-tensor-info-list ((weights safetensors-weights)) (weights-tensors weights))
(defmethod local:weights-tensor-info-ref ((weights safetensors-weights) name)
  (car (gethash name (weights-tensor-table weights))))
(defmethod local:weights-architecture-name ((weights safetensors-weights))
  (local::ensure-open weights)
  (let ((name (gethash "model_type" (weights-metadata-table weights))))
    (and (stringp name) name)))
(defmethod local:weights-release ((weights safetensors-weights))
  (release-shards (weights-shards weights)))

(defmethod local:weights-make-tensor ((weights safetensors-weights) (info safetensors-tensor))
  (local::ensure-open weights)
  (let ((type (find (local:tensor-info-format-type info) *types* :key #'second)))
    (unless (fourth type)
      (error 'local:unsupported-weights-type :tensor (local:tensor-info-name info)
             :format-type (second type) :message (format nil "No typed view for ~A" (first type))))
    (ct:make-tensor-view
     (trivial-simd:make-vector-view (safetensors-tensor-pointer info) (fourth type)
                                   (reduce #'* (local:tensor-info-shape info)))
     (local:tensor-info-shape info) :dtype (fifth type))))

(defmethod local:weights-make-bytes ((weights safetensors-weights) (info safetensors-tensor))
  (local::ensure-open weights)
  (let ((size (local:tensor-info-byte-count info)))
    (ct:make-tensor-view (trivial-simd:make-vector-view (safetensors-tensor-pointer info) :u8 size)
                         (list size))))

(local:register-weights-format
 :safetensors
 :detect (lambda (path header)
           (if (uiop:directory-exists-p path)
               (or (probe-file (merge-pathnames "model.safetensors.index.json"
                                               (uiop:ensure-directory-pathname path)))
                   (probe-file (merge-pathnames "model.safetensors" (uiop:ensure-directory-pathname path))))
               (or (index-path-p path)
                   (equal (pathname-type path) "safetensors")
                   (and (>= (length header) 9) (= (aref header 8) #x7b)
                        (<= 2 (loop for i below 8 sum (ash (aref header i) (* 8 i)))
                            +maximum-json-bytes+)))))
 :open #'open-safetensors)
