(in-package #:cl-inference/local)

(defclass sentencepiece-tokenizer (tokenizer)
  ((scores :reader spm-scores)
   (add-prefix :reader spm-add-prefix-p))
  (:metaclass tokenizer-class))

(define-tokenizer llama-spm (sentencepiece-tokenizer)
  (:format :gguf (:model "llama") (:pre "sentencepiece") (:add-bos t)))

(defun spm-boolean (weights name default)
  (let ((value (weights-metadata weights (gguf-tokenizer-key name) default)))
    (unless (member value '(nil t))
      (tokenizer-fail 'tokenizer-error "~A must be a boolean" name))
    value))

(defmethod tokenizer-load ((tokenizer llama-spm) (format (eql :gguf)) weights)
  (let* ((tokens (weights-metadata weights (gguf-tokenizer-key "tokens")))
         (types (weights-metadata weights (gguf-tokenizer-key "token_type")))
         (scores (weights-metadata weights (gguf-tokenizer-key "scores"))))
    (unless (and (vectorp tokens) (plusp (length tokens))
                 (every (lambda (token) (and (stringp token) (plusp (length token)))) tokens)
                 (vectorp types) (= (length types) (length tokens))
                 (every (lambda (type) (and (integerp type) (<= 1 type 6))) types)
                 (vectorp scores) (= (length scores) (length tokens))
                 (every (lambda (score) (and (typep score 'single-float)
                                            (not (float-features:float-nan-p score))
                                            (not (float-features:float-infinity-p score)))) scores))
      (tokenizer-fail 'tokenizer-error "SentencePiece needs tokens, token types and finite F32 scores of equal length"))
    (when (spm-boolean weights "add_eos_token" nil)
      (tokenizer-fail 'tokenizer-error "SentencePiece automatic EOS insertion is unsupported"))
    (when (spm-boolean weights "remove_extra_whitespaces" nil)
      (tokenizer-fail 'tokenizer-error "SentencePiece whitespace normalization is unsupported"))
    (let* ((size (length tokens)) (ids (make-hash-table :test 'equal :size size))
           (octets (make-array size)) (specials (make-hash-table))
           (byte-ids (make-array 256 :initial-element nil)))
      (dotimes (id size)
        (let ((token (aref tokens id)) (type (aref types id)))
          (when (gethash token ids)
            (tokenizer-fail 'tokenizer-error "Duplicate SentencePiece token ~S" token))
          (setf (gethash token ids) id
                (aref octets id)
                (case type
                  (1 (utf8-octets (substitute #\Space #\▁ token)))
                  (6 (let ((byte (and (= (length token) 6)
                                      (string= token "<0x" :end1 3)
                                      (char= (char token 5) #\>)
                                      (digit-char-p (char token 3) 16)
                                      (digit-char-p (char token 4) 16)
                                      (parse-integer token :start 3 :end 5 :radix 16))))
                       (unless (and byte (<= 0 byte 255) (null (aref byte-ids byte)))
                         (tokenizer-fail 'tokenizer-error "Invalid SentencePiece byte token ~S" token))
                       (setf (aref byte-ids byte) id)
                       (make-array 1 :element-type '(unsigned-byte 8) :initial-element byte)))
                  (t (utf8-octets token))))
          (when (<= +token-unknown+ type +token-user-defined+)
            (push (cons token id) (gethash (char token 0) specials)))))
      (unless (every #'identity byte-ids)
        (tokenizer-fail 'tokenizer-error "SentencePiece vocabulary needs all 256 byte tokens"))
      (maphash (lambda (char entries)
                 (setf (gethash char specials)
                       (sort entries #'> :key (lambda (entry) (length (car entry)))))) specials)
      (setf (slot-value tokenizer 'tokens) (coerce tokens 'simple-vector)
            (slot-value tokenizer 'types) types
            (slot-value tokenizer 'ids) ids
            (slot-value tokenizer 'octets) octets
            (slot-value tokenizer 'specials) specials
            (slot-value tokenizer 'byte-ids) byte-ids
            (slot-value tokenizer 'scores) scores
            (slot-value tokenizer 'add-prefix) (spm-boolean weights "add_space_prefix" t))
      (spm-boolean weights "add_bos_token" t)
      (load-gguf-special-ids tokenizer weights)
      (dolist (entry '((:bos . 1) (:eos . 2) (:unk . 0)))
        (unless (getf (tokenizer-special-ids tokenizer) (car entry))
          (check-token-id tokenizer (cdr entry))
          (setf (getf (slot-value tokenizer 'special-ids) (car entry)) (cdr entry))))))
  tokenizer)

(defstruct spm-pair left right size score)

(defun spm-pair-before-p (left right)
  (or (> (spm-pair-score left) (spm-pair-score right))
      (and (= (spm-pair-score left) (spm-pair-score right))
           (< (spm-pair-left left) (spm-pair-left right)))))

(defun spm-heap-push (heap pair)
  (vector-push-extend pair heap)
  (loop for child = (1- (length heap)) then parent
        for parent = (ash (1- child) -1)
        while (and (> child 0) (spm-pair-before-p (aref heap child) (aref heap parent)))
        do (rotatef (aref heap child) (aref heap parent))))

(defun spm-heap-pop (heap)
  (let ((top (aref heap 0)) (last (vector-pop heap)))
    (when (plusp (length heap))
      (setf (aref heap 0) last)
      (loop for parent = 0 then child for left = (1+ (* 2 parent))
            while (< left (length heap))
            for child = (if (and (< (1+ left) (length heap))
                                 (spm-pair-before-p (aref heap (1+ left)) (aref heap left)))
                            (1+ left) left)
            while (spm-pair-before-p (aref heap child) (aref heap parent))
            do (rotatef (aref heap child) (aref heap parent))))
    top))

(defmethod make-encoding-work ((tokenizer llama-spm)) nil)

(defmethod encode-plain ((tokenizer llama-spm) text out work)
  (declare (ignore work))
  (let* ((text (substitute #\▁ #\Space
                           (if (spm-add-prefix-p tokenizer) (concatenate 'string " " text) text)))
         (n (length text)) (ends (make-array n :element-type 'fixnum))
         (next (make-array n :element-type 'fixnum))
         (previous (make-array n :element-type 'fixnum))
         (heap (make-array 0 :adjustable t :fill-pointer 0)))
    (dotimes (i n)
      (setf (aref ends i) (1+ i) (aref previous i) (1- i)
            (aref next i) (if (= i (1- n)) -1 (1+ i))))
    (labels ((offer (left right)
               (when (and (>= left 0) (>= right 0))
                 (let ((id (gethash (subseq text left (aref ends right)) (tokenizer-ids tokenizer))))
                   (when id
                     (spm-heap-push heap (make-spm-pair :left left :right right
                                                      :size (- (aref ends right) left)
                                                      :score (aref (spm-scores tokenizer) id))))))))
      (loop for i below (1- n) do (offer i (1+ i)))
      (loop while (plusp (length heap))
            for pair = (spm-heap-pop heap)
            for left = (spm-pair-left pair) for right = (spm-pair-right pair)
            when (and (> (aref ends left) left) (> (aref ends right) right)
                      (= (aref next left) right)
                      (= (- (aref ends right) left) (spm-pair-size pair)))
              do (setf (aref ends left) (aref ends right)
                       (aref ends right) right
                       (aref next left) (aref next right))
                 (when (>= (aref next right) 0)
                   (setf (aref previous (aref next right)) left))
                 (offer (aref previous left) left)
                 (offer left (aref next left))))
    ;; Merged spans are vocabulary entries; only original characters need byte fallback.
    (loop for i = 0 then (aref next i) while (and (plusp n) (>= i 0))
          for piece = (subseq text i (aref ends i))
          for id = (gethash piece (tokenizer-ids tokenizer))
          do (if id (vector-push-extend id out)
                 (loop for byte across (utf8-octets piece)
                       do (vector-push-extend (aref (tokenizer-byte-ids tokenizer) byte) out))))))
