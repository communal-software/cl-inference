(in-package #:cl-inference/local)

(define-condition reply-parser-error (chat-template-error) ())

(defun reply-parser-fail (control &rest args)
  (error 'reply-parser-error :message (apply #'format nil control args)))

(defclass reply-parser ()
  ((builtins :initarg :builtins :initform nil :reader parser-builtins)
   (style :initarg :style :reader parser-style)
   (tools :initarg :tools :reader parser-tools)
   (sink :initarg :sink :reader parser-sink)
   (ref :initarg :ref :reader parser-ref)
   (state :initform :start :accessor parser-state)
   (pending :initform "" :accessor parser-pending)
   (buffer :initform (make-array 64 :element-type 'character :adjustable t :fill-pointer 0)
           :reader parser-buffer)
   (delta :initform (make-string-output-stream) :reader parser-delta)
   (text :initform (make-string-output-stream) :reader parser-text)
   (reasoning :initform nil :accessor parser-reasoning)
   (calls :initform nil :accessor parser-calls)
   (call-count :initform 0 :accessor parser-call-count)
   (quoted :initform nil :accessor parser-quoted)
   (escaped :initform nil :accessor parser-escaped)
   (finished :initform nil :accessor parser-finished)))

(defgeneric make-reply-parser (template &key tools sink ref &allow-other-keys)
  (:documentation "Create a per-turn parser. SINK receives neutral text and validated tool deltas.")
  (:method ((template chat-template) &key tools sink ref &allow-other-keys)
    (when tools (chat-template-fail "Unsupported: this template cannot render tools"))
    (make-instance 'reply-parser :style :plain :tools tools :sink sink :ref ref))
  (:method ((template qwen3-chat) &key tools sink ref &allow-other-keys)
    (make-instance 'reply-parser :style :qwen :tools tools :sink sink :ref ref))
  (:method ((template llama3-chat) &key tools sink ref &allow-other-keys)
    (make-instance 'reply-parser :style :llama :tools tools :sink sink :ref ref)))

(defmethod make-reply-parser ((template qwen25-chat) &key tools sink ref &allow-other-keys)
  (make-instance 'reply-parser :style :json :tools tools :sink sink :ref ref))

(defmethod make-reply-parser ((template hermes-chat) &key tools sink ref &allow-other-keys)
  (make-instance 'reply-parser :style :json :tools tools :sink sink :ref ref))

(defmethod make-reply-parser ((template qwq-chat) &key tools sink ref (enable-thinking t) &allow-other-keys)
  (let ((parser (make-instance 'reply-parser :style :qwen :tools tools :sink sink :ref ref)))
    (setf (parser-state parser) (if enable-thinking :reasoning :text))
    parser))

(defmethod make-reply-parser ((template qwen3-coder-chat) &key tools sink ref (enable-thinking t) &allow-other-keys)
  (let ((parser (make-instance 'reply-parser :style :function :tools tools :sink sink :ref ref)))
    (setf (parser-state parser) (if (and (typep template 'qwen35-chat) enable-thinking) :reasoning :text))
    parser))

(defmethod make-reply-parser ((template r1-chat) &key tools sink ref (enable-thinking t) &allow-other-keys)
  (let ((parser (make-instance 'reply-parser :style :r1 :tools tools :sink sink :ref ref)))
    (setf (parser-state parser) (if (or enable-thinking (typep template 'r1-llama-chat)) :reasoning :text))
    parser))

(defmethod make-reply-parser ((template llama30-chat) &key tools sink ref &allow-other-keys)
  (when tools (chat-template-fail "Llama 3.0 does not support tools"))
  (make-instance 'reply-parser :style :plain :tools nil :sink sink :ref ref))

(defmethod make-reply-parser ((template llama31-chat) &key tools sink ref builtin-tools &allow-other-keys)
  (checked-builtin-tools builtin-tools tools)
  (make-instance 'reply-parser :style :llama :builtins builtin-tools :tools tools :sink sink :ref ref))

(defun parser-release (parser text)
  (when (plusp (length text))
    (write-string text (parser-text parser))
    (write-string text (parser-delta parser))))

(defun parser-flush (parser)
  (let ((text (get-output-stream-string (parser-delta parser))))
    (when (plusp (length text))
      (ci:emit-event (parser-sink parser) (ci:text-delta (parser-ref parser) text)))))

(defun parser-clear-buffer (parser)
  (setf (fill-pointer (parser-buffer parser)) 0))

(defun parser-tool (parser name arguments)
  (let* ((tool (find name (parser-tools parser) :key (lambda (tool) (getf tool :name))))
         (schema (and tool (ci:tool-schema tool))))
    (unless tool (reply-parser-fail "Undeclared tool ~S" name))
    (unless (hash-table-p arguments) (reply-parser-fail "Tool arguments must be an object"))
    (let* ((args (ci:json->arguments arguments schema))
           (call (list :id (format nil "local-~D" (incf (parser-call-count parser)))
                       :name name :arguments args :schema schema)))
      (multiple-value-bind (checked problem) (ci:coerce-args schema args)
        (declare (ignore checked))
        (when problem (reply-parser-fail "Invalid tool arguments: ~A" problem)))
      (parser-flush parser)
      (push call (parser-calls parser))
      (ci:emit-event (parser-sink parser)
                     (ci:tool-call-delta (parser-ref parser) :id (getf call :id) :name name
                                         :arguments (com.inuoe.jzon:stringify arguments))))))

(defun parser-json-call (parser text key)
  (handler-case
      (let ((json (com.inuoe.jzon:parse text)))
        (unless (hash-table-p json) (reply-parser-fail "Tool call must be an object"))
        (let ((name (gethash "name" json)))
          (unless (and (stringp name) (plusp (length name)))
            (reply-parser-fail "Tool call needs a name"))
          (parser-tool parser (ci:lisp-tool-name name) (gethash key json))))
    (reply-parser-error (e) (error e))
    (error (e) (reply-parser-fail "Invalid tool call: ~A" e))))

(defun parse-output-json (text)
  (handler-case (com.inuoe.jzon:parse text)
    (error (condition) (reply-parser-fail "Invalid tool value: ~A" condition))))

(defun function-parameter-value (text spec)
  ;; TODO: untyped/nullable scalar strings can lose type; add explicit codecs (#56).
  (cond ((ci::spec-is spec "OR")
         (if (string= text "None") (parse-output-json "null")
             (function-parameter-value text (third spec))))
        ((or (ci::spec-is spec "STRING") (ci::spec-is spec "MEMBER")) text)
        ((ci::spec-is spec "ANY")
         (handler-case (parse-output-json text) (reply-parser-error () text)))
        (t (parse-output-json (cond ((string= text "True") "true")
                                   ((string= text "False") "false")
                                   ((string= text "None") "null") (t text))))))

(defun parser-function-call (parser text)
  (let ((position 0) (arguments (make-hash-table :test 'equal)))
    (labels ((expect (literal)
               (unless (and (<= (+ position (length literal)) (length text))
                            (string= literal text :start2 position :end2 (+ position (length literal))))
                 (reply-parser-fail "Expected ~S in function call" literal))
               (incf position (length literal)))
             (until (literal)
               (let ((end (search literal text :start2 position)))
                 (unless end (reply-parser-fail "Missing ~S in function call" literal))
                 (prog1 (subseq text position end) (setf position (+ end (length literal)))))))
      (expect (format nil "~%<function="))
      (let* ((name (ci:lisp-tool-name (until (format nil ">~%"))))
             (tool (find name (parser-tools parser) :key (lambda (tool) (getf tool :name)))))
        (unless tool (reply-parser-fail "Undeclared tool ~S" name))
        (loop while (and (< position (length text)) (char= (char text position) #\<)
                         (not (uiop:string-prefix-p "</function>" (subseq text position))))
              do (expect "<parameter=")
                 (let* ((key (until (format nil ">~%")))
                        (param (find key (ci:tool-schema tool) :key #'ci::param-key :test #'string=))
                        (value (until (format nil "~%</parameter>~%"))))
                   (unless param (reply-parser-fail "Unknown parameter ~S" key))
                   (when (nth-value 1 (gethash key arguments)) (reply-parser-fail "Duplicate parameter ~S" key))
                   (setf (gethash key arguments) (function-parameter-value value (ci:param-type param)))))
        (expect (format nil "</function>~%"))
        (unless (= position (length text)) (reply-parser-fail "Trailing function-call content"))
        (parser-tool parser name arguments)))))

(defun parser-r1-calls (parser text)
  (let ((position 0))
    (loop
      (let* ((prefix "<｜tool▁call▁begin｜>function<｜tool▁sep｜>")
             (name-start (+ position (length prefix)))
             (name-end (position #\Newline text :start (min name-start (length text))))
             (json-marker (format nil "~%```json~%")))
        (unless (and (<= name-start (length text))
                     (string= prefix text :start2 position :end2 name-start) name-end
                     (uiop:string-prefix-p json-marker (subseq text name-end)))
          (reply-parser-fail "Invalid R1 tool call"))
        (let* ((start (+ name-end (length json-marker)))
               (end (search (format nil "~%```<｜tool▁call▁end｜>") text :start2 start)))
          (unless end (reply-parser-fail "Unterminated R1 tool call"))
          (parser-tool parser (ci:lisp-tool-name (subseq text name-start name-end))
                       (parse-output-json (subseq text start end)))
          (setf position (+ end (length (format nil "~%```<｜tool▁call▁end｜>"))))
          (when (= position (length text)) (return))
          (unless (char= (char text position) #\Newline) (reply-parser-fail "Invalid R1 call separator"))
          (incf position))))))

(defun parser-python-call (parser text)
  (let ((call (search ".call(" text)))
    (if (and call (plusp call) (parser-builtins parser)
             (every (lambda (char) (or (alphanumericp char) (char= char #\_)))
                    (subseq text 0 call)))
        (let* ((name (ci:lisp-tool-name (subseq text 0 call)))
               (position (+ call 6)) (end (1- (length text)))
               (arguments (make-hash-table :test 'equal)))
          (unless (and (member name (parser-builtins parser)) (char= (char text end) #\)))
            (reply-parser-fail "Invalid or undeclared builtin call"))
          (loop while (< position end)
                for equal = (position #\= text :start position :end end)
                do (unless equal (reply-parser-fail "Builtin argument needs ="))
                   (let ((key (subseq text position equal)) (start (1+ equal)) (quoted-end nil) (escaped nil))
                     (unless (and (< start end) (char= (char text start) #\"))
                       (reply-parser-fail "Builtin argument needs a quoted string"))
                     (loop for i from (1+ start) below end
                           for char = (char text i)
                           do (cond (escaped (setf escaped nil))
                                    ((char= char #\\) (setf escaped t))
                                    ((char= char #\") (setf quoted-end (1+ i)) (return))))
                     (unless quoted-end (reply-parser-fail "Unterminated builtin string"))
                     (when (nth-value 1 (gethash key arguments)) (reply-parser-fail "Duplicate builtin argument"))
                     (setf (gethash key arguments) (parse-output-json (subseq text start quoted-end))
                           position quoted-end)
                     (when (< position end)
                       (unless (and (<= (+ position 2) end) (string= ", " text :start2 position :end2 (+ position 2)))
                         (reply-parser-fail "Invalid builtin argument separator"))
                       (incf position 2)
                       (when (= position end) (reply-parser-fail "Trailing builtin argument separator")))))
          (parser-tool parser name arguments))
        (let* ((name (if (member :code_interpreter (parser-builtins parser)) :code_interpreter :python))
               (tool (find name (parser-tools parser) :key (lambda (tool) (getf tool :name))))
               (param (find :code (ci:tool-schema tool) :key #'ci:param-name)))
          (unless (and param (ci::spec-is (ci:param-type param) "STRING"))
            (reply-parser-fail "Python output needs a declared code string tool"))
          (let ((arguments (make-hash-table :test 'equal)))
            (setf (gethash "code" arguments) text)
            (parser-tool parser name arguments))))))

(defun marker-prefix-p (text marker)
  (and (<= (length text) (length marker))
       (string= text marker :end2 (length text))))

(declaim (ftype function parser-character))

(defun parser-start (parser char)
  (let ((style (parser-style parser)))
    (cond
      ((member style '(:plain :json :function :r1))
       (setf (parser-state parser) :text)
       (parser-character parser char))
      ((and (zerop (length (parser-pending parser))) (python-space-p char))
       (vector-push-extend char (parser-buffer parser)))
      (t
       (setf (parser-pending parser) (concatenate 'string (parser-pending parser) (string char)))
       (let* ((pending (parser-pending parser))
              (marker (if (eq style :qwen) "<think>" "<|python_tag|>")))
         (cond
           ((string= pending marker)
            (parser-clear-buffer parser)
            (setf (parser-pending parser) "" (parser-state parser)
                  (if (eq style :qwen) :reasoning :python)))
           ((and (eq style :llama) (parser-tools parser) (string= pending "{"))
            (parser-clear-buffer parser)
            (vector-push-extend char (parser-buffer parser))
            (setf (parser-pending parser) "" (parser-state parser) :llama))
           ((marker-prefix-p pending marker))
           (t
            (parser-release parser (parser-buffer parser))
            (parser-clear-buffer parser)
            (setf (parser-pending parser) "" (parser-state parser) :text)
            (loop for c across pending do (parser-character parser c)))))))))

(defun parser-tool-character (parser char)
  (vector-push-extend char (parser-buffer parser))
  (cond
    ((parser-escaped parser) (setf (parser-escaped parser) nil))
    ((and (parser-quoted parser) (char= char #\\)) (setf (parser-escaped parser) t))
    ((char= char #\") (setf (parser-quoted parser) (not (parser-quoted parser)))))
  (let* ((buffer (parser-buffer parser)) (end (length buffer)) (marker "</tool_call>"))
    (when (and (not (parser-quoted parser)) (>= end (length marker))
               (string= marker buffer :start2 (- end (length marker))))
      (if (eq (parser-style parser) :function)
          (parser-function-call parser (subseq buffer 0 (- end (length marker))))
          (parser-json-call parser (subseq buffer 0 (- end (length marker))) "arguments"))
      (parser-clear-buffer parser)
      (setf (parser-state parser) :text))))

(defun parser-character (parser char)
  (case (parser-state parser)
    (:start (parser-start parser char))
    ((:llama :python) (vector-push-extend char (parser-buffer parser)))
    (:tool (if (eq (parser-style parser) :function)
               (progn
                 (vector-push-extend char (parser-buffer parser))
                 (let ((buffer (parser-buffer parser)))
                   (when (uiop:string-suffix-p buffer (format nil "</function>~%</tool_call>"))
                     (parser-function-call parser (subseq buffer 0 (- (length buffer) (length "</tool_call>"))))
                     (parser-clear-buffer parser)
                     (setf (parser-state parser) :text))))
               (parser-tool-character parser char)))
    (:r1-tool
     (vector-push-extend char (parser-buffer parser))
     (when (uiop:string-suffix-p (parser-buffer parser) "<｜tool▁calls▁end｜>")
       (parser-r1-calls parser (subseq (parser-buffer parser) 0
                                      (- (length (parser-buffer parser)) (length "<｜tool▁calls▁end｜>"))))
       (parser-clear-buffer parser)
       (setf (parser-state parser) :text)))
    (:after-reasoning
     (unless (char= char #\Newline)
       (setf (parser-state parser) :text)
       (parser-character parser char)))
    (otherwise
     (let* ((reasoning (eq (parser-state parser) :reasoning))
            (marker (if reasoning "</think>"
                        (if (eq (parser-style parser) :r1) "<｜tool▁calls▁begin｜>" "<tool_call>")))
            (pending (concatenate 'string (parser-pending parser) (string char))))
       (if (and (not reasoning) (not (member (parser-style parser) '(:qwen :json :function :r1))))
           (parser-release parser (string char))
           (multiple-value-bind (out held matched) (stop-split pending (list marker))
             (if reasoning
                 (loop for c across out do (vector-push-extend c (parser-buffer parser)))
                 (parser-release parser out))
             (setf (parser-pending parser) held)
             (when matched
               (if reasoning
                   (progn
                     (setf (parser-reasoning parser)
                           (string-trim '(#\Newline) (coerce (parser-buffer parser) 'simple-string))
                           (parser-state parser) :after-reasoning)
                     (parser-clear-buffer parser))
                   (setf (parser-state parser) (if (eq (parser-style parser) :r1) :r1-tool :tool))))))))))

(defgeneric reply-parser-push (parser text)
  (:documentation "Feed decoded TEXT, retaining incomplete syntax until the next chunk.")
  (:method ((parser reply-parser) text)
    (when (parser-finished parser) (reply-parser-fail "Parser is finished"))
    (loop for char across text do (parser-character parser char))
    (parser-flush parser)
    parser))

(defgeneric reply-parser-finish (parser)
  (:documentation "Finish parsing; return (values content-text tool-calls reasoning).")
  (:method ((parser reply-parser))
    (when (parser-finished parser) (reply-parser-fail "Parser is finished"))
    (case (parser-state parser)
      ((:tool :r1-tool) (reply-parser-fail "Truncated tool call"))
      (:llama (parser-json-call parser (parser-buffer parser) "parameters"))
      (:python (parser-python-call parser (coerce (parser-buffer parser) 'string)))
      (:reasoning
       (setf (parser-reasoning parser)
             (string-trim '(#\Newline) (concatenate 'string (parser-buffer parser)
                                                    (parser-pending parser)))))
      (:start
       (parser-release parser (parser-buffer parser))
       (parser-release parser (parser-pending parser)))
      (otherwise (parser-release parser (parser-pending parser))))
    (parser-flush parser)
    (setf (parser-finished parser) t)
    (values (get-output-stream-string (parser-text parser))
            (nreverse (parser-calls parser)) (parser-reasoning parser))))
