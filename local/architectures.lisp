(in-package #:cl-inference/local)

;;; GGUF `llama` permutes Q and K, so RoPE rotates adjacent pairs.

(define-architecture llama ()
  (:hparams (n-layers) (dim) (n-heads) (n-kv-heads) (rms-epsilon)
            (rope-theta :default 10000.0) (rope-dims :default nil) (head-dim :default nil)
            (context-length :default nil) (rope-scaling :default nil))
  (:blocks (attn attention) (mlp swiglu-mlp))
  (:model-blocks (token embedding) (head lm-head))
  (:format :gguf
    (:arch "llama")
    (:rope-pairing :adjacent)
    (:chat-template llama3-chat)
    (:hparam n-layers "~a.block_count")
    (:hparam dim "~a.embedding_length")
    (:hparam n-heads "~a.attention.head_count")
    (:hparam n-kv-heads "~a.attention.head_count_kv")
    (:hparam rms-epsilon "~a.attention.layer_norm_rms_epsilon")
    (:hparam rope-theta "~a.rope.freq_base")
    (:hparam rope-dims "~a.rope.dimension_count")
    (:hparam head-dim "~a.attention.key_length")
    (:hparam context-length "~a.context_length")
    (:tensor attn.norm "blk.~d.attn_norm.weight")
    (:tensor attn.q "blk.~d.attn_q.weight")
    (:tensor attn.k "blk.~d.attn_k.weight")
    (:tensor attn.v "blk.~d.attn_v.weight")
    (:tensor attn.output "blk.~d.attn_output.weight")
    (:tensor attn.rope-freqs "rope_freqs.weight" :optional t)
    (:tensor mlp.norm "blk.~d.ffn_norm.weight")
    (:tensor mlp.gate "blk.~d.ffn_gate.weight")
    (:tensor mlp.up "blk.~d.ffn_up.weight")
    (:tensor mlp.down "blk.~d.ffn_down.weight")
    (:tensor token.embd "token_embd.weight")
    (:tensor head.norm "output_norm.weight")
    (:tensor head.output "output.weight" :fallback token.embd))
  (:format :safetensors
    (:arch "llama")
    (:chat-template llama3-chat)
    (:rope-pairing :neox)
    (:hparam n-layers "num_hidden_layers")
    (:hparam dim "hidden_size")
    (:hparam n-heads "num_attention_heads")
    (:hparam n-kv-heads "num_key_value_heads")
    (:hparam rms-epsilon "rms_norm_eps")
    (:hparam rope-theta "rope_theta")
    (:hparam head-dim "head_dim")
    (:hparam context-length "max_position_embeddings")
    (:hparam rope-scaling "rope_scaling")
    (:tensor attn.norm "model.layers.~d.input_layernorm.weight")
    (:tensor attn.q "model.layers.~d.self_attn.q_proj.weight")
    (:tensor attn.k "model.layers.~d.self_attn.k_proj.weight")
    (:tensor attn.v "model.layers.~d.self_attn.v_proj.weight")
    (:tensor attn.output "model.layers.~d.self_attn.o_proj.weight")
    (:tensor attn.rope-freqs nil :optional t)
    (:tensor mlp.norm "model.layers.~d.post_attention_layernorm.weight")
    (:tensor mlp.gate "model.layers.~d.mlp.gate_proj.weight")
    (:tensor mlp.up "model.layers.~d.mlp.up_proj.weight")
    (:tensor mlp.down "model.layers.~d.mlp.down_proj.weight")
    (:tensor token.embd "model.embed_tokens.weight")
    (:tensor head.norm "model.norm.weight")
    (:tensor head.output "lm_head.weight" :fallback token.embd)))

(define-architecture qwen3 (llama)
  (:blocks (attn attention :qk-norm t))
  (:format :gguf
    (:arch "qwen3")
    (:rope-pairing :neox)
    (:chat-template qwen3-chat)
    (:tensor attn.q-norm "blk.~d.attn_q_norm.weight")
    (:tensor attn.k-norm "blk.~d.attn_k_norm.weight"))
  (:format :safetensors
    (:arch "qwen3")
    (:chat-template qwen3-chat)
    (:tensor attn.q-norm "model.layers.~d.self_attn.q_norm.weight")
    (:tensor attn.k-norm "model.layers.~d.self_attn.k_norm.weight")))
