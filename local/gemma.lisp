(in-package #:cl-inference/local)

(defmethod tokenizer-load :after ((tokenizer llama-spm) (format (eql :gguf)) weights)
  (when (equal "gemma3" (weights-architecture-name weights))
    (let ((types (copy-seq (tokenizer-types tokenizer))))
      ;; llama.cpp promotes the checkpoint's user-defined </s> alias to an EOG control.
      (dolist (name '("</s>" "<end_of_turn>" "<eos>"))
        (let ((id (token-id tokenizer name)))
          (when (and id (= (aref types id) +token-user-defined+))
            (setf (aref types id) +token-control+))))
      (setf (slot-value tokenizer 'types) types))))

(defclass gemma3-embedding (embedding)
  ((scale :reader gemma3-embedding-scale)))

(defmethod bind-block :after ((block gemma3-embedding) architecture weights)
  (declare (ignore weights))
  (setf (slot-value block 'scale) (sqrt (float (hparam architecture 'dim) 1f0))))

(defmethod block-forward :around ((block gemma3-embedding) tokens &key &allow-other-keys)
  (ct:multiply (call-next-method) (gemma3-embedding-scale block)))

(defclass gemma3-attention (attention)
  ((post-norm :reader gemma3-attention-post-norm)
   (window :reader gemma3-attention-window)))

(defmethod bind-block :after ((block gemma3-attention) architecture weights)
  (let* ((pattern (hparam architecture 'sliding-pattern))
         (window (hparam architecture 'sliding-window))
         (local-p (and (plusp window)
                       (if (vectorp pattern) (aref pattern (block-layer block))
                           (< (mod (block-layer block) pattern) (1- pattern))))))
    (setf (slot-value block 'post-norm) (block-tensor block architecture weights "post-norm")
          (slot-value block 'window) (and local-p window))
    (when local-p
      (setf (attn-rope-theta block) (hparam architecture 'local-rope-theta)))))

(defmethod attention-mask ((block gemma3-attention) count key-count query-start key-start)
  ;; TODO: full-prefix storage and scoring grow with context; use bounded local-layer caches (#70).
  (causal-mask count key-count query-start key-start (gemma3-attention-window block)))

(defmethod block-forward :around ((block gemma3-attention) x &key &allow-other-keys)
  (apply-rmsnorm (call-next-method) (gemma3-attention-post-norm block) (attn-epsilon block)))

(defclass gemma3-mlp (swiglu-mlp)
  ((post-norm :reader gemma3-mlp-post-norm)))

(defmethod bind-block :after ((block gemma3-mlp) architecture weights)
  (setf (slot-value block 'post-norm) (block-tensor block architecture weights "post-norm")))

(defmethod block-forward ((block gemma3-mlp) x &key &allow-other-keys)
  (let* ((h (apply-rmsnorm x (mlp-norm block) (mlp-epsilon block)))
         (delta (linear (ct:multiply (ct:gelu (linear h (mlp-gate block)))
                                     (linear h (mlp-up block)))
                        (mlp-down block))))
    (apply-rmsnorm delta (gemma3-mlp-post-norm block) (mlp-epsilon block))))

(define-architecture gemma3 (llama)
  (:hparams (sliding-window :default 0) (sliding-pattern :default 6)
            (local-rope-theta :default 10000f0) (logit-softcap :default 0f0))
  (:blocks (attn gemma3-attention :qk-norm t) (mlp gemma3-mlp))
  (:model-blocks (token gemma3-embedding))
  (:format :gguf
    (:arch "gemma3")
    (:rope-pairing :neox)
    (:chat-template gemma3-chat)
    (:hparam sliding-window "~a.attention.sliding_window")
    (:hparam sliding-pattern "~a.attention.sliding_window_pattern")
    (:hparam local-rope-theta "~a.rope.freq_base_swa")
    (:hparam logit-softcap "~a.final_logit_softcapping")
    (:tensor attn.q-norm "blk.~d.attn_q_norm.weight")
    (:tensor attn.k-norm "blk.~d.attn_k_norm.weight")
    (:tensor attn.post-norm "blk.~d.post_attention_norm.weight")
    (:tensor mlp.post-norm "blk.~d.post_ffw_norm.weight"))
  (:format :safetensors (:arch nil)))

(defmethod validate-model-weights (weights (architecture gemma3))
  (flet ((fail (control &rest args) (apply #'architecture-fail 'architecture-error control args))
         (positive-integer-p (value) (and (integerp value) (plusp value))))
    (let* ((layers (hparam architecture 'n-layers))
           (dim (hparam architecture 'dim)) (heads (hparam architecture 'n-heads))
           (kv (hparam architecture 'n-kv-heads)) (head (hparam architecture 'head-dim))
           (window (hparam architecture 'sliding-window))
           (pattern (hparam architecture 'sliding-pattern)))
      (unless (and (every #'positive-integer-p (list layers dim heads kv head))
                   (zerop (mod heads kv)) (evenp head)
                   (integerp window) (not (minusp window))
                   (or (positive-integer-p pattern)
                       (and (vectorp pattern) (= layers (length pattern))
                            (every (lambda (entry) (member entry '(nil t))) pattern))))
        (fail "Invalid Gemma 3 dimensions or sliding-window pattern"))
      (unless (and (zerop (hparam architecture 'logit-softcap))
                   (null (hparam architecture 'rope-scaling))
                   (= (hparam-or architecture 'rope-dims head) head)
                   (every (lambda (value) (and (realp value) (plusp value)))
                          (list (hparam architecture 'rms-epsilon)
                                (hparam architecture 'rope-theta)
                                (hparam architecture 'local-rope-theta)))
                   (= head (weights-metadata weights "gemma3.attention.value_length" head)))
        (fail "Unsupported Gemma 3 attention, RoPE or logit settings"))
      (labels ((shape (role expected &optional layer)
                 (let ((actual (ct:tensor-shape (architecture-tensor architecture weights role layer))))
                   (unless (equalp actual (coerce expected 'vector))
                     (fail "Gemma 3 tensor ~A at layer ~S has shape ~S, expected ~S"
                           role layer actual expected)))))
        (let* ((embedding (architecture-tensor architecture weights 'token.embd))
               (vocab (aref (ct:tensor-shape embedding) 0)))
          (shape 'token.embd (list vocab dim))
          (shape 'head.output (list vocab dim))
          (shape 'head.norm (list dim)))
        (dotimes (layer layers)
          (dolist (role '(attn.norm attn.post-norm mlp.norm mlp.post-norm))
            (shape role (list dim) layer))
          (dolist (role '(attn.q-norm attn.k-norm)) (shape role (list head) layer))
          (shape 'attn.q (list (* heads head) dim) layer)
          (dolist (role '(attn.k attn.v)) (shape role (list (* kv head) dim) layer))
          (shape 'attn.output (list dim (* heads head)) layer)
          (let* ((gate (architecture-tensor architecture weights 'mlp.gate layer))
                 (ffn (aref (ct:tensor-shape gate) 0)))
            (shape 'mlp.gate (list ffn dim) layer)
            (shape 'mlp.up (list ffn dim) layer)
            (shape 'mlp.down (list dim ffn) layer)))))))

(define-chat-template gemma3-chat ()
  (:detect "<start_of_turn>" "first_user_prefix" "Conversation roles must alternate" "<start_of_image>")
  (:exclude "<|im_start|>" "<|channel>" "<|tool" "<think>")
  (:message "<start_of_turn>~A~%~A<end_of_turn>~%")
  (:generation-prompt "<start_of_turn>model~%")
  (:stop "<end_of_turn>" "<eos>" "</s>"))

(defmethod render-chat ((template gemma3-chat) messages &key tools add-generation-prompt &allow-other-keys)
  (when (or tools
            (some (lambda (message)
                    (or (getf message :tool-calls)
                        (not (member (getf message :role) '(:system :user :assistant)))
                        (some (lambda (block) (not (eq :text (getf block :type))))
                              (ci:normalize-content (getf message :content))))) messages))
    (chat-template-fail "Gemma 3 accepts text conversations without tools"))
  (unless messages (chat-template-fail "Gemma 3 needs at least one message"))
  (let* ((system (when (eq (getf (first messages) :role) :system) (pop messages)))
         (prefix (when system (format nil "~A~%~%" (message-text system)))))
    (chat-rendering
     (append
      (loop for message in messages for index from 0
            for role = (getf message :role)
            do (unless (eq role (if (evenp index) :user :assistant))
                 (chat-template-fail "Gemma 3 roles must alternate user/assistant"))
            append (render-turn template (if (eq role :assistant) "model" "user")
                                (append (when (and prefix (zerop index)) (chat-text prefix))
                                        (chat-text (trim-whitespace (message-text message))))))
      (when add-generation-prompt (render-generation-prompt template))))))
