(in-package #:cl-inference/mlx)

(defstruct quantized-weight packed scales biases group-size)

(defclass mlx-weights (local:weights)
  ((source :initarg :source :reader source-weights)
   (arrays :initform (make-hash-table :test 'equal) :reader imported-arrays)))

(defmethod local:weights-metadata-ref ((weights mlx-weights) key)
  (local:weights-metadata (source-weights weights) key))
(defmethod local:weights-tensor-info-ref ((weights mlx-weights) name)
  (local:weights-tensor-info-ref (source-weights weights) name))
(defmethod local:weights-metadata-key-list ((weights mlx-weights))
  (local:weights-metadata-keys (source-weights weights)))
(defmethod local:weights-tensor-info-list ((weights mlx-weights))
  (local:weights-tensor-info-list (source-weights weights)))
(defmethod local:weights-architecture-name ((weights mlx-weights))
  (local:weights-architecture-name (source-weights weights)))

(defun model-fail (control &rest args)
  (apply #'local::architecture-fail 'local:architecture-error control args))

(defun quantization-config (weights name)
  (let* ((source (source-weights weights))
         (config (or (local:weights-metadata source "quantization")
                     (local:weights-metadata source "quantization_config")))
         (module (subseq name 0 (- (length name) 7))))
    (unless (hash-table-p config) (model-fail "Packed tensor ~A needs MLX affine quantization metadata" name))
    (let* ((override (gethash module config))
           (settings (if (hash-table-p override) override config))
           (bits (gethash "bits" settings)) (group (gethash "group_size" settings))
           (mode (gethash "mode" settings "affine")))
      (unless (and (eql bits 4) (member group '(32 64 128)) (equal mode "affine"))
        (model-fail "~A requires affine 4-bit quantization with group_size 32, 64 or 128" name))
      group)))

(defun import-array (weights name)
  (or (gethash name (imported-arrays weights))
      (let* ((source (source-weights weights)) (info (local:weights-tensor-info source name))
             (type (local:tensor-info-format-type info))
             (bytes (local:weights-tensor-bytes source name))
             (pointer (trivial-simd:vector-view-pointer (ct:tensor-storage bytes))))
        (unless (member type '(:f32 :f16 :bf16 :u32))
          (model-fail "Unsupported MLX tensor dtype ~A for ~A" type name))
        (setf (gethash name (imported-arrays weights))
              (mx:from-pointer pointer (local:tensor-info-shape info) :dtype type)))))

(defun import-f32-array (weights name)
  (let ((array (import-array weights name)))
    (unless (member (mx:dtype array) '(:f32 :f16 :bf16))
      (model-fail "Quantization scales and biases must be floating-point: ~A" name))
    (if (eq (mx:dtype array) :f32) array
        (let ((converted (mx:astype array :f32)))
          (setf (gethash name (imported-arrays weights)) converted)
          (mx:release array)
          converted))))

(defmethod local:weights-make-tensor ((weights mlx-weights) info)
  (let* ((name (local:tensor-info-name info)) (array (import-array weights name)))
    (if (eq (mx:dtype array) :u32)
        (let* ((base (subseq name 0 (- (length name) 7)))
               (group (quantization-config weights name))
               (scales (import-f32-array weights (concatenate 'string base ".scales")))
               (biases (import-f32-array weights (concatenate 'string base ".biases")))
               (shape (mx:shape array)) (scale-shape (mx:shape scales)))
          (unless (and (= (length shape) 2) (= (length scale-shape) 2)
                       (equal scale-shape (mx:shape biases))
                       (= (first shape) (first scale-shape))
                       (= (* 8 (second shape)) (* group (second scale-shape)))
                       (member (mx:dtype scales) '(:f32 :f16 :bf16))
                       (eq (mx:dtype scales) (mx:dtype biases)))
            (model-fail "Invalid packed weights/scales/biases shapes for ~A" name))
          (make-quantized-weight :packed array :scales scales :biases biases :group-size group))
        array)))

(defgeneric weight-shape (weight))
(defmethod weight-shape (weight)
  (if (quantized-weight-p weight)
      (let ((shape (mx:shape (quantized-weight-packed weight))))
        (list (first shape) (* 8 (second shape))))
      (mx:shape weight)))

(defun require-shape (weight expected)
  (unless (equal (weight-shape weight) expected)
    (model-fail "Expected weight shape ~S, got ~S" expected (weight-shape weight))))

(defgeneric mlx-linear (x weight))
(defmethod mlx-linear (x weight)
  (if (quantized-weight-p weight)
      (mx:quantized-matmul x (quantized-weight-packed weight)
                          (quantized-weight-scales weight) (quantized-weight-biases weight)
                          (quantized-weight-group-size weight))
      (mx:matmul x (mx:transpose weight))))

(defgeneric mlx-embedding (weight tokens))
(defmethod mlx-embedding (weight tokens)
  (if (quantized-weight-p weight)
      (mx:dequantize (mx:take (quantized-weight-packed weight) tokens)
                     (mx:take (quantized-weight-scales weight) tokens)
                     (mx:take (quantized-weight-biases weight) tokens)
                     (quantized-weight-group-size weight))
      (mx:astype (mx:take weight tokens) :f32)))

(defclass mlx-attention (local:attention) ())
(defclass mlx-mlp (local:swiglu-mlp) ())
(defclass mlx-embedding (local:embedding) ())
(defclass mlx-head (local:lm-head) ())

(defmethod local:bind-block :after ((block mlx-attention) architecture weights)
  (let* ((dim (local:hparam architecture 'local::dim))
         (head (local::attn-head-dim block)) (heads (local::attn-n-heads block))
         (kv (local::attn-n-kv-heads block)) (freqs (local::attn-rope-freqs block)))
    (require-shape (local::attn-norm block) (list dim))
    (require-shape (local::attn-q block) (list (* head heads) dim))
    (require-shape (local::attn-k block) (list (* head kv) dim))
    (require-shape (local::attn-v block) (list (* head kv) dim))
    (require-shape (local::attn-output block) (list dim (* head heads)))
    (when (typep freqs 'mx:array)
      (require-shape freqs (list (floor (local::attn-rope-dims block) 2))))
    (when (local::attention-qk-norm block)
      (require-shape (local::attn-q-norm block) (list head))
      (require-shape (local::attn-k-norm block) (list head)))
    (when freqs
      (let* ((dims (local::attn-rope-dims block)) (half (floor dims 2))
             (theta (local::attn-rope-theta block))
             (array (mx:with-array-scope ()
                      (let* ((bases (loop for i below half collect (expt theta (/ (* 2 i) dims))))
                             (result (if (typep freqs 'mx:array)
                                         (mx:multiply freqs (mx:from-data bases (list half)))
                                         (mx:from-data
                                          (loop for base in bases for i from 0
                                                collect (* base (ct:tref freqs i))) (list half)))))
                        (mx:retain result)))))
        (setf (gethash (format nil "rope.~D" (local:block-layer block)) (imported-arrays weights)) array
              (local::attn-rope-freqs block) array)))))

(defmethod local:bind-block :after ((block mlx-mlp) architecture weights)
  (declare (ignore weights))
  (let ((dim (local:hparam architecture 'local::dim))
        (hidden (first (weight-shape (local::mlp-gate block)))))
    (require-shape (local::mlp-norm block) (list dim))
    (require-shape (local::mlp-gate block) (list hidden dim))
    (require-shape (local::mlp-up block) (list hidden dim))
    (require-shape (local::mlp-down block) (list dim hidden))))

(defmethod local:bind-block :after ((block mlx-embedding) architecture weights)
  (declare (ignore weights))
  (unless (= (length (weight-shape (local::embedding-table block))) 2)
    (model-fail "Embedding weight must be a matrix"))
  (require-shape (local::embedding-table block)
                 (list (first (weight-shape (local::embedding-table block)))
                       (local:hparam architecture 'local::dim))))

(defmethod local:bind-block :after ((block mlx-head) architecture weights)
  (declare (ignore weights))
  (require-shape (local::head-norm block) (list (local:hparam architecture 'local::dim)))
  (unless (= (length (weight-shape (local::head-output block))) 2)
    (model-fail "Output weight must be a matrix"))
  (require-shape (local::head-output block)
                 (list (first (weight-shape (local::head-output block)))
                       (local:hparam architecture 'local::dim))))

(defmethod local:block-forward ((block mlx-embedding) tokens &key &allow-other-keys)
  (mlx-embedding (local::embedding-table block) tokens))

(defmethod local:block-forward ((block mlx-mlp) x &key &allow-other-keys)
  (let* ((h (mx:rmsnorm x (local::mlp-norm block) (local::mlp-epsilon block)))
         (gate (mlx-linear h (local::mlp-gate block))))
    (mlx-linear (mx:multiply (mx:multiply gate (mx:sigmoid gate))
                            (mlx-linear h (local::mlp-up block)))
                (local::mlp-down block))))

(defmethod local:block-forward ((block mlx-head) x &key last-only &allow-other-keys)
  (let* ((shape (mx:shape x)) (rows (first shape))
         (x (if last-only (mx:slice x (list (1- rows) 0) shape) x)))
    (mx:astype (mlx-linear (mx:rmsnorm x (local::head-norm block) (local::head-epsilon block))
                          (local::head-output block)) :f32)))

(defun attention-layout (x count heads head)
  (mx:reshape (mx:transpose (mx:reshape x (list count heads head)) '(1 0 2))
              (list 1 heads count head)))

(defstruct (mlx-cache (:constructor make-mlx-cache (n-ctx &key (cache-type :f32))))
  n-ctx cache-type (layers (make-hash-table)) (closed-p nil))
(defstruct mlx-q8-buffer codes scales)
(defvar *cache-updates* nil)

(defun cache-arrays (buffer)
  (if (mlx-q8-buffer-p buffer)
      (list (mlx-q8-buffer-codes buffer) (mlx-q8-buffer-scales buffer))
      (list buffer)))

(defun update-arrays (update)
  (append (cache-arrays (fourth update)) (cache-arrays (fifth update))))

(defmethod local::cache-storage-bytes ((cache mlx-cache))
  (loop for pair being the hash-values of (mlx-cache-layers cache)
        sum (loop for array in (append (cache-arrays (car pair)) (cache-arrays (cdr pair)))
                  sum (* (if (eq (mx:dtype array) :s8) 1 4) (mx:size array)))))

(defun mlx-store-cache (old rows start capacity cache-type)
  (let* ((shape (mx:shape rows)) (end (+ start (third shape)))
         (full (list 1 (second shape) capacity (fourth shape)))
         (stop (list 1 (second shape) end (fourth shape))))
    (flet ((store (buffer input target-shape target-stop)
             (mx:slice-update (or buffer (mx:zeros target-shape :dtype (mx:dtype input))) input
                              (list 0 0 start 0) target-stop)))
      (if (eq cache-type :f32)
          (store old rows full stop)
          (multiple-value-bind (codes scales) (mx:symmetric-quantize rows)
            (let ((groups (ceiling (fourth shape) local::+kv-group-size+)))
              (make-mlx-q8-buffer
               :codes (store (and old (mlx-q8-buffer-codes old)) codes full stop)
               :scales (store (and old (mlx-q8-buffer-scales old)) scales
                              (list 1 (second shape) capacity groups)
                              (list 1 (second shape) end groups)))))))))

;; TODO: F32 prefix scratch grows with context; use tiled or fused Q8 attention (#57).
(defun mlx-cache-prefix (buffer end)
  (flet ((prefix (array)
           (let ((shape (mx:shape array)))
             (mx:slice array '(0 0 0 0) (list 1 (second shape) end (fourth shape))))))
    (if (mlx-q8-buffer-p buffer)
        (mx:symmetric-dequantize (prefix (mlx-q8-buffer-codes buffer))
                                (prefix (mlx-q8-buffer-scales buffer)))
        (prefix buffer))))

;; TODO: full-capacity slice updates; donate or chunk buffers when context traffic matters (#49).
(defmethod local:kv-cache-update ((cache mlx-cache) layer k v start)
  (when (mlx-cache-closed-p cache) (local::session-fail "MLX cache is closed"))
  (let* ((shape (mx:shape k)) (end (+ start (third shape)))
         (capacity (mlx-cache-n-ctx cache))
         (old (gethash layer (mlx-cache-layers cache))))
    (when (> end capacity) (local::context-fail "MLX cache exceeds context ~D" capacity))
    (let* ((keys (mlx-store-cache (car old) k start capacity (mlx-cache-cache-type cache)))
           (values (mlx-store-cache (cdr old) v start capacity (mlx-cache-cache-type cache))))
      (push (list cache layer old keys values) *cache-updates*)
      (values (mlx-cache-prefix keys end) (mlx-cache-prefix values end)))))

(defmethod local:close-cache ((cache mlx-cache))
  (unless (mlx-cache-closed-p cache)
    (setf (mlx-cache-closed-p cache) t)
    (maphash (lambda (layer pair)
               (declare (ignore layer))
               (mapc #'mx:release (append (cache-arrays (car pair)) (cache-arrays (cdr pair)))))
             (mlx-cache-layers cache))
    (clrhash (mlx-cache-layers cache)))
  nil)

(defmethod local:block-forward ((block mlx-attention) x &key (start 0) cache &allow-other-keys)
  (let* ((count (first (mx:shape x))) (heads (local::attn-n-heads block))
         (kv (local::attn-n-kv-heads block)) (head (local::attn-head-dim block))
         (epsilon (local::attn-epsilon block))
         (h (mx:rmsnorm x (local::attn-norm block) epsilon))
         (q (attention-layout (mlx-linear h (local::attn-q block)) count heads head))
         (k (attention-layout (mlx-linear h (local::attn-k block)) count kv head))
         (v (attention-layout (mlx-linear h (local::attn-v block)) count kv head)))
    (when (local::attention-qk-norm block)
      (setf q (mx:rmsnorm q (local::attn-q-norm block) epsilon)
            k (mx:rmsnorm k (local::attn-k-norm block) epsilon)))
    (flet ((rotate (a)
             (mx:rope a (local::attn-rope-dims block)
                      :traditional (eq (local::attn-rope-pairing block) :adjacent)
                      :base (local::attn-rope-theta block) :offset start
                      :freqs (local::attn-rope-freqs block))))
      (setf q (rotate q) k (rotate k)))
    (multiple-value-bind (keys values)
        (if cache (local:kv-cache-update cache (local:block-layer block) k v start) (values k v))
      (let* ((out (mx:attention q keys values (/ 1 (sqrt head)) :causal (> count 1)))
             (flat (mx:reshape (mx:transpose out '(0 2 1 3)) (list count (* heads head)))))
        (mlx-linear flat (local::attn-output block))))))

(defstruct (mlx-model (:include local:model)
                      (:constructor %make-mlx-model (architecture layers model-blocks weights)))
  weights (closed-p nil))

(defmethod local:make-model-cache ((model mlx-model) n-ctx &key (cache-type :f32))
  (make-mlx-cache n-ctx :cache-type cache-type))
(defmethod local:model-ready-p ((model mlx-model))
  (and (not (mlx-model-closed-p model))
       (not (local:weights-closed-p (source-weights (mlx-model-weights model))))))
(defmethod local:close-model ((model mlx-model))
  (unless (mlx-model-closed-p model)
    (setf (mlx-model-closed-p model) t)
    (maphash (lambda (name array) (declare (ignore name)) (mx:release array))
             (imported-arrays (mlx-model-weights model)))
    (clrhash (imported-arrays (mlx-model-weights model))))
  nil)

(defun make-mlx-block (architecture spec slot layer weights)
  (destructuring-bind (class &rest arguments) spec
    (let ((class (or (cdr (assoc class '((local:attention . mlx-attention)
                                       (local:swiglu-mlp . mlx-mlp)
                                       (local:embedding . mlx-embedding) (local:lm-head . mlx-head))))
                     (model-fail "Unsupported MLX block ~S" class))))
      (let ((block (apply #'make-instance class :slot slot :layer layer arguments)))
        (local:bind-block block architecture weights)
        block))))

(defgeneric prepare-mlx-weights (source))
(defmethod prepare-mlx-weights (source)
  (unless (eq (local:weights-format source) :safetensors)
    (model-fail "Load cl-inference/mlx-gguf for GGUF weights; otherwise MLX requires Safetensors"))
  (make-instance 'mlx-weights :source source :format :safetensors :path (local:weights-path source)))

(defgeneric validate-mlx-source (weights architecture))
(defmethod validate-mlx-source ((weights mlx-weights) architecture)
  (st::validate-hf-model (source-weights weights) architecture :quantized t))

(defun load-mlx-model (source)
  "Build a Llama or Qwen3 model over MLX-owned arrays; SOURCE remains borrowed."
  (local::ensure-open source)
  (unless (mx:available-p) (model-fail "Metal device is unavailable"))
  (let* ((architecture (local:load-architecture source))
         (weights (prepare-mlx-weights source))
         (success nil))
    (unless (typep architecture 'local:llama) (model-fail "MLX supports Llama and Qwen3"))
    (validate-mlx-source weights architecture)
    (unwind-protect
         (let ((model
                 (%make-mlx-model architecture
                   (loop for layer below (local:hparam architecture 'local::n-layers)
                         collect (loop for slot in (local:architecture-block-slots architecture)
                                       collect (make-mlx-block architecture (local:architecture-block-spec architecture slot)
                                                               slot layer weights)))
                   (loop for slot in (local:architecture-model-block-slots architecture)
                         collect (make-mlx-block architecture (local:architecture-model-block-spec architecture slot)
                                                 slot nil weights)) weights)))
           (let ((embedding (local::embedding-table (local::model-block-of-type model 'local:embedding)))
                 (output (local::head-output (local::model-block-of-type model 'local:lm-head))))
             (unless (= (first (weight-shape embedding)) (first (weight-shape output)))
               (model-fail "Embedding and output vocabulary sizes differ")))
           (setf success t)
           model)
      (unless success
        (maphash (lambda (name array) (declare (ignore name)) (mx:release array)) (imported-arrays weights))))))

(defun q8-layer-forward (block x start cache)
  (let ((previous *cache-updates*) (saved nil) (result nil))
    (mx:with-array-scope ()
      (setf result (mx:add x (local:block-forward block x :start start :cache cache))
            saved (loop for tail on *cache-updates* until (eq tail previous)
                        append (update-arrays (car tail))))
      (apply #'mx:eval result saved)
      (mapc #'mx:retain saved)
      (mx:retain result))
    (dolist (array (cons result saved)) (push array mx::*array-scope*))
    result))

(defmethod local:model-forward ((model mlx-model) tokens &key (start 0) cache all-logits)
  (unless (local:model-ready-p model) (local::session-fail "MLX model or borrowed weights are closed"))
  (let ((vocabulary (first (weight-shape
                           (local::embedding-table (local::model-block-of-type model 'local:embedding))))))
    (unless (and (plusp (length tokens))
                 (every (lambda (token) (and (integerp token) (<= 0 token) (< token vocabulary))) tokens))
      (local::session-fail "MLX requires nonempty token IDs within the embedding vocabulary")))
  (mx:with-array-scope ()
    (let* ((*cache-updates* nil)
           (x (local:block-forward (local::model-block-of-type model 'local:embedding)
                                    (mx:from-data tokens (list (length tokens)) :dtype :s32))))
      (dolist (blocks (local:model-layers model))
        (dolist (block blocks)
          (setf x (if (and cache (eq (mlx-cache-cache-type cache) :q8))
                      (q8-layer-forward block x start cache)
                      (mx:add x (local:block-forward block x :start start :cache cache))))))
      (let ((logits (local:block-forward (local::model-block-of-type model 'local:lm-head)
                                          x :last-only (not all-logits))))
        (apply #'mx:eval logits (loop for update in *cache-updates* append (update-arrays update)))
        (let ((result (ct:reshape (ct:from-data (mx:to-vector logits :evaluate nil)) (mx:shape logits))))
          (dolist (update *cache-updates*)
            (destructuring-bind (cache layer old k v) update
              (mapc #'mx:retain (append (cache-arrays k) (cache-arrays v)))
              (setf (gethash layer (mlx-cache-layers cache)) (cons k v))
              (when old
                (mapc #'mx:release (append (cache-arrays (car old)) (cache-arrays (cdr old)))))))
          result)))))
