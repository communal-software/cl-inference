(require :asdf)
(require :sb-sprof)
(load "/Users/george/quicklisp/setup.lisp")
(asdf:initialize-source-registry '(:source-registry (:directory "/Users/george/git/cl-inference/") (:directory "/Users/george/git/trivial-simd/") :inherit-configuration))
(asdf:load-system :cl-inference/local/acceptance)
(defpackage #:inference-hotspots (:use #:cl) (:local-nicknames (#:local #:cl-inference/local) (#:accept #:cl-inference/acceptance) (#:tests #:cl-inference/local/tests)))
(in-package #:inference-hotspots)
(let* ((kind (intern (uiop:getenv "PROFILE_MODEL") :keyword))
       (phase (uiop:getenv "PROFILE_PHASE")))
  (assert (accept::verified-model-p kind))
  (local:with-weights (weights (accept::model-path kind))
    (let* ((model (local:load-model weights))
           (tokenizer (local:load-tokenizer weights))
           (base (local:encode tokenizer "The capital of France is"))
           (prompt (loop for i below 128 collect (aref base (mod i (length base)))))
           (cache (local:make-kv-cache 136))
           (expected (tests::greedy-continuation model prompt 4)))
      (unwind-protect
           (progn
             (format t "~&VERIFY ~S ~S~%" kind expected)
             (local:model-forward model prompt :cache cache)
             (flet ((step-model ()
                      (if (string= phase "prefill")
                          (local:model-forward model prompt)
                          (local:model-forward model (list (first expected)) :start 128 :cache cache))))
               (step-model)
               (sb-ext:gc :full t)
               (sb-sprof:reset)
               (format t "~&READY ~A ~A~%" kind phase)
               (finish-output)
               (sleep 3)
               (sb-sprof:start-profiling :mode :cpu :sample-interval 0.002 :max-samples 100000)
               (let ((start (get-internal-real-time)) (count 0))
                 (unwind-protect
                      (loop do (step-model) (incf count)
                            while (< (/ (- (get-internal-real-time) start) internal-time-units-per-second) 30))
                   (sb-sprof:stop-profiling))
                 (format t "~&MEASURE ~A ~A calls=~D elapsed=~,3F~%" kind phase count
                         (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
               (sb-sprof:report :type :graph :max 60 :min-percent 0.5 :show-progress nil)))
        (local:close-cache cache)))))
