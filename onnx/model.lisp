(in-package #:cl-inference/onnx)

(define-condition onnx-error (local:weights-error) ())
(defun fail (control &rest args) (apply #'local:weights-fail 'onnx-error control args))

(defclass model-files (hf::hf-weights)
  ((metadata :initarg :metadata :reader files-metadata)))
(defmethod local:weights-metadata-ref ((files model-files) key)
  (gethash key (files-metadata files)))
(defmethod local:weights-metadata-key-list ((files model-files))
  (loop for key being the hash-keys of (files-metadata files) collect key))
(defmethod local:weights-architecture-name ((files model-files))
  (gethash "model_type" (files-metadata files)))
(defmethod local:weights-release ((files model-files)) nil)

(defstruct (onnx-model (:include local:model) (:constructor %make-model))
  runtime files layers-count kv-heads head-dim vocab context)
(defstruct onnx-cache tensors (position 0))

(defun config-positive (config key)
  (let ((value (gethash key config)))
    (unless (typep value '(integer 1)) (fail "config.json needs positive ~A" key))
    value))

(defun compatible-shape-p (shape expected)
  (and (= (length shape) (length expected))
       (every (lambda (actual wanted) (if (eq wanted :dynamic) (= actual -1) (or (= actual -1) (= actual wanted)))) shape expected)))

(defun validate-signature (runtime model)
  (let ((inputs (ox:session-inputs runtime)) (outputs (ox:session-outputs runtime))
        (layers (onnx-model-layers-count model)) (heads (onnx-model-kv-heads model))
        (dim (onnx-model-head-dim model)) (vocab (onnx-model-vocab model)))
    (labels ((require-info (infos name dtype shape)
               (let ((info (find name infos :key #'ox:value-info-name :test #'equal)))
                 (unless (and info (eq dtype (ox:value-info-dtype info))
                              (compatible-shape-p (ox:value-info-shape info) shape))
                   (fail "Unsupported ONNX signature for ~A; expected ~S ~S" name dtype shape)))))
      (unless (and (= (length inputs) (+ 3 (* 2 layers))) (= (length outputs) (+ 1 (* 2 layers))))
        (fail "Expected one decoder-with-past graph with token, mask, position, logits and K/V tensors"))
      (dolist (name '("input_ids" "attention_mask" "position_ids"))
        (require-info inputs name :i64 '(1 :dynamic)))
      (require-info outputs "logits" :f32 (list 1 :dynamic vocab))
      (dotimes (layer layers)
        (dolist (part '("key" "value"))
          (require-info inputs (format nil "past_key_values.~D.~A" layer part) :f32 (list 1 heads :dynamic dim))
          (require-info outputs (format nil "present.~D.~A" layer part) :f32 (list 1 heads :dynamic dim)))))))

(defun load-onnx-model (directory graph)
  (unless (and graph (not (uiop:absolute-pathname-p graph)) (equal "onnx" (pathname-type graph)))
    (fail "Supply a relative .onnx graph filename"))
  (let* ((directory (truename (uiop:ensure-directory-pathname directory)))
         (path (truename (merge-pathnames graph directory)))
         (config (hf::read-json-file (merge-pathnames "config.json" directory)))
         (runtime nil) (success nil))
    (unless (uiop:subpathp path directory) (fail "Graph must remain inside the model directory"))
    (unless (equal "llama" (gethash "model_type" config)) (fail "ONNX v1 supports Llama decoder exports"))
    (unwind-protect
         (let* ((heads (config-positive config "num_attention_heads"))
                (hidden (config-positive config "hidden_size"))
                (dim (gethash "head_dim" config (/ hidden heads)))
                (model (%make-model :runtime (setf runtime (ox:open-session path))
                                    :files (make-instance 'model-files :format :onnx
                                                          :path (merge-pathnames "config.json" directory) :metadata config)
                                    :layers-count (config-positive config "num_hidden_layers")
                                    :kv-heads (config-positive config "num_key_value_heads")
                                    :head-dim dim :vocab (config-positive config "vocab_size")
                                    :context (config-positive config "max_position_embeddings"))))
           (unless (and (typep dim '(integer 1)) (zerop (mod heads (onnx-model-kv-heads model))))
             (fail "Invalid ONNX attention dimensions"))
           (validate-signature runtime model)
           (setf success t)
           model)
      (unless success (ox:release runtime)))))

(defmethod local:model-ready-p ((model onnx-model)) (not (null (onnx-model-runtime model))))
(defmethod local:close-model ((model onnx-model))
  (ox:release (onnx-model-runtime model))
  (setf (onnx-model-runtime model) nil)
  (local:close-weights (onnx-model-files model)))
(defmethod local:make-model-cache ((model onnx-model) n-ctx &key (cache-type :f32))
  (declare (ignore n-ctx))
  (unless (eq cache-type :f32) (fail "ONNX caches require :f32"))
  (let ((cache (make-onnx-cache)) (success nil) (ci::*defer-exchange-interrupt* t))
    (unwind-protect
         (progn
           (dotimes (layer (onnx-model-layers-count model))
             (dolist (part '("key" "value"))
               (push (cons (format nil "past_key_values.~D.~A" layer part)
                           (ox:make-tensor nil (list 1 (onnx-model-kv-heads model) 0 (onnx-model-head-dim model))))
                     (onnx-cache-tensors cache))))
           (when ci::*exchange* (ci::check-exchange-reason ci::*exchange*))
           (setf success t)
           cache)
      (unless success (local:close-cache cache)))))
(defmethod local:close-cache ((cache onnx-cache))
  (mapc (lambda (pair) (ox:release (cdr pair))) (onnx-cache-tensors cache))
  (setf (onnx-cache-tensors cache) nil))

(defmethod local:model-forward ((model onnx-model) tokens &key (start 0) cache all-logits)
  (unless (and cache (= start (onnx-cache-position cache)))
    (fail "ONNX cache positions must advance sequentially"))
  (let ((count (length tokens)) (inputs nil) (outputs nil) (options nil)
        (ci::*defer-exchange-interrupt* t))
    (unwind-protect
         (progn
           (setf options (ox:make-run-options))
           (push (cons "input_ids" (ox:make-tensor tokens (list 1 count) :dtype :i64)) inputs)
           (push (cons "attention_mask" (ox:make-tensor (make-list (+ start count) :initial-element 1)
                                                                      (list 1 (+ start count)) :dtype :i64)) inputs)
           (push (cons "position_ids" (ox:make-tensor (loop for i from start below (+ start count) collect i)
                                                                    (list 1 count) :dtype :i64)) inputs)
           (ci::call-with-native-abort
            (lambda () (ox:terminate-run options))
            (lambda () (setf outputs (ox:run (onnx-model-runtime model)
                                            (append inputs (onnx-cache-tensors cache)) :options options))))
           (let* ((logits (cdr (assoc "logits" outputs :test #'equal)))
                  (shape (ox:tensor-shape logits))
                  (vocab (onnx-model-vocab model))
                  (data (ox:tensor-data logits :start (if all-logits 0 (* (1- count) vocab))))
                  (past nil))
             (unless (equal shape (list 1 count vocab)) (fail "Unexpected logits shape ~S" shape))
             (dolist (pair outputs)
               (unless (equal (car pair) "logits")
                 (let* ((name (concatenate 'string "past_key_values." (subseq (car pair) (length "present."))))
                        (expected (list 1 (onnx-model-kv-heads model) (+ start count) (onnx-model-head-dim model))))
                   (unless (equal (ox:tensor-shape (cdr pair)) expected)
                     (fail "Unexpected cache shape for ~A" (car pair)))
                   (push (cons name (cdr pair)) past))))
             (let ((result (ct:reshape (ct:from-data data :dtype :f32)
                                       (list (if all-logits count 1) vocab))))
               (let ((ci::*defer-exchange-interrupt* t))
                 (local:close-cache cache)
                 (setf (onnx-cache-tensors cache) past (onnx-cache-position cache) (+ start count)
                       outputs (list (cons "logits" logits))))
               (when ci::*exchange* (ci::check-exchange-reason ci::*exchange*))
               result)))
      (mapc (lambda (pair) (ox:release (cdr pair))) inputs)
      (mapc (lambda (pair) (ox:release (cdr pair))) outputs)
      (ox:release options))))
