(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (and (not (find-package :ql)) (probe-file setup)) (load setup)))
(asdf:initialize-source-registry
 `(:source-registry (:directory ,(merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
                   :inherit-configuration))

(destructuring-bind (engine path cache-type output &optional (count "256") (capacity "1024"))
    (remove "--" (uiop:command-line-arguments) :test #'string= :count 1)
  (asdf:load-system (if (string= engine "mlx") "cl-inference/mlx" "cl-inference/gguf"))
  (let* ((local (find-package :cl-inference/local))
         (mlx (find-package :cl-inference/mlx))
         (type (intern (string-upcase cache-type) :keyword))
         (count (parse-integer count)) (capacity (parse-integer capacity)))
    (flet ((call (name &rest args) (apply (symbol-function (find-symbol name local)) args)))
      (let* ((weights (call "OPEN-WEIGHTS" path))
             (model nil) (session nil))
        (unwind-protect
             (progn
               (setf model (if (string= engine "mlx")
                               (funcall (find-symbol "LOAD-MLX-MODEL" mlx) weights)
                               (call "LOAD-MODEL" weights))
                     session (call "MAKE-SESSION" model :n-ctx capacity :cache-type type))
               (let ((prompt (make-array count :initial-element 42))
                     (extended (make-array (+ count 64) :initial-element 42)))
                 (call "SESSION-PREFILL" session #(42 42))
                 (with-open-file (stream output :direction :output :if-exists :append :if-does-not-exist :create)
                   (dotimes (trial 3)
                     (call "SESSION-RESET" session)
                     (flet ((measure (label tokens max-tokens)
                              (let ((start (get-internal-real-time)))
                                (multiple-value-bind (text finish ids usage)
                                    (call "GENERATE" session tokens :prompt-p t :max-tokens max-tokens
                                          :stop-ids nil :timeout 3600000)
                                  (declare (ignore text ids))
                                  (unless (eq finish :length) (error "Benchmark failed: ~S" finish))
                                  (format stream "~A,~A,~A,~D,~A,~D,~D,~,6F,~D~%"
                                          engine path type trial label (length tokens)
                                          (getf usage :cached-prompt-tokens)
                                          (/ (- (get-internal-real-time) start)
                                             (float internal-time-units-per-second 1d0))
                                          (call "CACHE-STORAGE-BYTES" (call "SESSION-CACHE" session)))))))
                       (measure "cold" prompt 0)
                       (measure "repeat" prompt 0)
                       (measure "extend" extended 0)
                       (measure "decode8" extended 8))))))
          (when session (call "CLOSE-SESSION" session))
          (when model (call "CLOSE-MODEL" model))
          (call "CLOSE-WEIGHTS" weights))))))
