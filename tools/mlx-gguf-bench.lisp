(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (and (not (find-package :ql)) (probe-file setup)) (load setup)))
(asdf:initialize-source-registry
 `(:source-registry (:directory ,(merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
                   :inherit-configuration))
(asdf:load-system "cl-inference/mlx-gguf")

(defpackage #:cl-inference/mlx-gguf/bench
  (:use #:cl)
  (:local-nicknames (#:local #:cl-inference/local) (#:mlx #:cl-inference/mlx) (#:mx #:cl-mlx)))
(in-package #:cl-inference/mlx-gguf/bench)

(cffi:defcfun ("mlx_get_active_memory" active-memory) :int (bytes :pointer))
(cffi:defcfun ("mlx_get_peak_memory" peak-memory) :int (bytes :pointer))
(cffi:defcfun ("mlx_reset_peak_memory" reset-peak-memory) :int)
(cffi:defcfun ("mlx_clear_cache" clear-memory-cache) :int)

(defun memory-bytes (function)
  (cffi:with-foreign-object (bytes :size)
    (unless (zerop (funcall function bytes)) (error "MLX memory query failed"))
    (cffi:mem-ref bytes :size)))

(defun seconds-since (start)
  (/ (- (get-internal-real-time) start) (float internal-time-units-per-second 1d0)))

(defun packed-bytes (model)
  (let ((total 0))
    (maphash (lambda (name weight)
               (declare (ignore name))
               (unless (and (eq (mx:dtype (mlx::gguf-packed-weight-bytes weight)) :u8)
                            (= (mx:size (mlx::gguf-packed-weight-bytes weight))
                               (* (reduce #'* (mlx::weight-shape weight))
                                  (/ (mlx::gguf-packed-weight-block-bytes weight)
                                     (mlx::gguf-packed-weight-elements weight)))))
                 (error "Packed weight storage changed"))
               (incf total (mx:size (mlx::gguf-packed-weight-bytes weight))))
             (mlx::packed-weights (mlx::mlx-model-weights model)))
    total))

(defun benchmark (path output count batch)
  (let ((start (get-internal-real-time)) (weights nil) (model nil) (session nil))
    (unwind-protect
         (progn
           (setf weights (local:open-weights path) model (mlx:load-mlx-model weights))
           (let ((load-seconds (seconds-since start)) (packed (packed-bytes model)))
             (setf session (local:make-session model :n-ctx (+ count 16) :n-batch batch))
             (with-open-file (stream output :direction :output :if-exists :supersede)
               (format stream "phase,trial,tokens,batch,seconds,active_bytes,peak_bytes,packed_bytes~%")
               (format stream "load,0,0,~D,~,6F,~D,~D,~D~%" batch load-seconds
                       (memory-bytes #'active-memory) (memory-bytes #'peak-memory) packed)
               (clear-memory-cache)
               (dotimes (trial 4)
                 (local:session-reset session)
                 (reset-peak-memory)
                 (let ((start (get-internal-real-time)))
                   (local:session-prefill session (make-array count :initial-element 42))
                   (format stream "~A,~D,~D,~D,~,6F,~D,~D,~D~%" (if (zerop trial) "cold-prefill" "prefill")
                           trial count batch (seconds-since start) (memory-bytes #'active-memory)
                           (memory-bytes #'peak-memory) (packed-bytes model)))
                 (reset-peak-memory)
                 (let ((start (get-internal-real-time)))
                   (dotimes (i 8) (local:session-prefill session '(42)))
                   (format stream "~A,~D,8,~D,~,6F,~D,~D,~D~%" (if (zerop trial) "cold-decode8" "decode8")
                           trial batch (seconds-since start) (memory-bytes #'active-memory)
                           (memory-bytes #'peak-memory) (packed-bytes model)))
                 (finish-output stream)))))
      (when session (local:close-session session))
      (when model (local:close-model model))
      (when weights (local:close-weights weights))
      (cl-mlx/gpu:clear-kernel-cache))))

(destructuring-bind (path output &optional (count "64") (batch "64"))
    (remove "--" (uiop:command-line-arguments) :test #'equal :count 1)
  (benchmark path output (parse-integer count) (parse-integer batch)))
